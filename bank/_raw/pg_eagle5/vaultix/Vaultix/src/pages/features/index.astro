<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { registerEagleEases } from "../../lib/eases";
  import { applyScrambleHover } from "../../lib/scramble-hover";

  gsap.registerPlugin(ScrollTrigger, SplitText);
  registerEagleEases();

  /* ---------- Hero intro animation ---------- */
  const initHero = () => {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduceMotion) {
      document.documentElement.classList.remove("features-hero-pre-anim");
      return;
    }
    const section = document.querySelector<HTMLElement>("[data-features-hero]");
    if (!section) return;

    const eyebrow = section.querySelector<HTMLElement>("[data-features-hero-eyebrow]");
    const headline = section.querySelector<HTMLElement>("[data-features-hero-headline]");
    const subhead = section.querySelector<HTMLElement>("[data-features-hero-subhead]");
    const buttons = section.querySelector<HTMLElement>("[data-features-hero-buttons]");
    const lines = gsap.utils.toArray<HTMLElement>("[data-features-hero-line]", section);
    const tmarks = gsap.utils.toArray<SVGElement>("[data-features-hero-tmark]", section);
    const cards = gsap.utils.toArray<HTMLElement>("[data-features-hero-card]", section);
    const bars = gsap.utils.toArray<HTMLElement>("[data-features-hero-bar]", section);
    const vbars = gsap.utils.toArray<HTMLElement>("[data-features-hero-vbar]", section);
    const stats = gsap.utils.toArray<HTMLElement>("[data-features-hero-stat]", section);
    const counter = section.querySelector<HTMLElement>("[data-features-hero-counter]");

    const eyebrowSplit = eyebrow ? new SplitText(eyebrow, { type: "lines", mask: "lines" }) : null;
    const headlineSplit = headline ? new SplitText(headline, { type: "lines", mask: "lines" }) : null;
    const subheadSplit = subhead ? new SplitText(subhead, { type: "lines", mask: "lines" }) : null;

    if (eyebrowSplit) gsap.set(eyebrowSplit.lines, { yPercent: 110 });
    if (headlineSplit) gsap.set(headlineSplit.lines, { yPercent: 110 });
    if (subheadSplit) gsap.set(subheadSplit.lines, { yPercent: 110 });
    if (buttons) gsap.set(buttons, { opacity: 0, y: 14 });

    lines.forEach((l) => {
      const o = l.dataset.featuresHeroLine;
      if (o === "bottom") gsap.set(l, { scaleX: 0, transformOrigin: "left center" });
      else gsap.set(l, { scaleY: 0, transformOrigin: "center top" });
    });
    if (tmarks.length) gsap.set(tmarks, { opacity: 0, scale: 0.4, transformOrigin: "center" });
    if (cards.length) gsap.set(cards, { opacity: 0, y: 24, scale: 0.96 });
    if (bars.length) gsap.set(bars, { scaleY: 0, transformOrigin: "bottom" });
    if (vbars.length) gsap.set(vbars, { scaleY: 0, transformOrigin: "bottom" });
    if (stats.length) gsap.set(stats, { opacity: 0, y: 8 });

    document.documentElement.classList.remove("features-hero-pre-anim");

    const tl = gsap.timeline();
    tl.to(lines, { scaleX: 1, scaleY: 1, duration: 0.8, ease: "eagleStructure", stagger: 0.05 }, 0);
    if (tmarks.length) tl.to(tmarks, { opacity: 1, scale: 1, duration: 0.4, ease: "eagleDecor", stagger: 0.06 }, 0.5);
    if (eyebrowSplit) tl.to(eyebrowSplit.lines, { yPercent: 0, duration: 0.65, ease: "eagleReveal", stagger: 0.05 }, 0.3);
    if (headlineSplit) tl.to(headlineSplit.lines, { yPercent: 0, duration: 0.9, ease: "eagleReveal", stagger: 0.1 }, 0.45);
    if (subheadSplit) tl.to(subheadSplit.lines, { yPercent: 0, duration: 0.7, ease: "eagleReveal", stagger: 0.05 }, 0.65);
    if (buttons) tl.to(buttons, { opacity: 1, y: 0, duration: 0.55, ease: "eagleReveal" }, 0.85);

    // Cards cascade in from bottom-left → top-right (matches the Figma
    // diagonal stack: deepest card animates first).
    if (cards.length) {
      tl.to(cards, {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.7,
        ease: "eagleStructure",
        stagger: 0.18,
      }, 0.6);
    }
    // Inner chart elements animate after the cards land.
    if (bars.length) tl.to(bars, { scaleY: 1, duration: 0.04, ease: "none", stagger: { each: 0.025 } }, 1.2);
    if (vbars.length) tl.to(vbars, { scaleY: 1, duration: 0.5, ease: "eagleStructure", stagger: 0.04 }, 1.4);
    if (stats.length) tl.to(stats, { opacity: 1, y: 0, duration: 0.5, ease: "eagleReveal", stagger: 0.06 }, 1.5);

    // Count-up for the events/sec counter on Card 1.
    if (counter) {
      const target = parseInt(counter.dataset.featuresHeroCounterTarget || "1240", 10);
      const proxy = { val: 0 };
      tl.to(proxy, {
        val: target,
        duration: 1.2,
        ease: "eagleReveal",
        snap: { val: 1 },
        onUpdate: () => {
          counter.textContent = proxy.val.toLocaleString("en-US");
        },
      }, 1.3);
    }
  };

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initHero);
  else initHero();

  /* ---------- Solution intro animation ---------- */
  const initSolution = () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      document.documentElement.classList.remove("features-solution-pre-anim");
      return;
    }
    const section = document.querySelector<HTMLElement>("[data-features-solution]");
    if (!section) return;
    const cards = gsap.utils.toArray<HTMLElement>("[data-features-solution-card]", section);

    type CardParts = {
      lines: HTMLElement[];
      icon: HTMLElement | null;
      titleSplit: SplitText | null;
      bodySplit: SplitText | null;
    };

    const cardParts: CardParts[] = cards.map((card) => {
      const titleEl = card.querySelector<HTMLElement>("[data-features-solution-card-title]");
      const bodyEl = card.querySelector<HTMLElement>("[data-features-solution-card-body]");
      return {
        lines: gsap.utils.toArray<HTMLElement>("[data-features-solution-card-line]", card),
        icon: card.querySelector<HTMLElement>("[data-features-solution-card-icon]"),
        titleSplit: titleEl ? new SplitText(titleEl, { type: "lines", mask: "lines" }) : null,
        bodySplit: bodyEl ? new SplitText(bodyEl, { type: "lines", mask: "lines" }) : null,
      };
    });

    cardParts.forEach(({ lines, icon, titleSplit, bodySplit }) => {
      lines.forEach((line) => {
        const side = line.dataset.featuresSolutionCardLine;
        const isHorizontal = side === "top" || side === "bottom";
        gsap.set(line, isHorizontal ? { scaleX: 0 } : { scaleY: 0 });
      });
      if (icon) gsap.set(icon, { opacity: 0, scale: 0.6, transformOrigin: "center" });
      if (titleSplit) gsap.set(titleSplit.lines, { yPercent: 110 });
      if (bodySplit) gsap.set(bodySplit.lines, { yPercent: 110 });
    });

    document.documentElement.classList.remove("features-solution-pre-anim");

    const tl = gsap.timeline({ scrollTrigger: { trigger: section, comeca: "top 80%", once: true } });

    cardParts.forEach(({ lines, icon, titleSplit, bodySplit }, idx) => {
      const cardStart = idx * 0.12;

      lines.forEach((line, lineIdx) => {
        const side = line.dataset.featuresSolutionCardLine;
        const isHorizontal = side === "top" || side === "bottom";
        tl.to(line, {
          [isHorizontal ? "scaleX" : "scaleY"]: 1,
          duration: 0.55,
          ease: "eagleStructure",
        }, cardStart + lineIdx * 0.06);
      });

      if (icon) {
        tl.to(icon, {
          opacity: 1,
          scale: 1,
          duration: 0.5,
          ease: "eagleDecor",
        }, cardStart + 0.35);
      }
      if (titleSplit) {
        tl.to(titleSplit.lines, {
          yPercent: 0,
          duration: 0.55,
          ease: "eagleReveal",
          stagger: 0.06,
        }, cardStart + 0.4);
      }
      if (bodySplit) {
        tl.to(bodySplit.lines, {
          yPercent: 0,
          duration: 0.5,
          ease: "eagleReveal",
          stagger: 0.05,
        }, cardStart + 0.5);
      }
    });
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initSolution);
  else initSolution();

  /* ---------- Core Recursos slider (auto-rotate + click pills) ---------- */
  const initCore = () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const section = document.querySelector<HTMLElement>("[data-features-core]");
    if (!section) return;

    if (reduceMotion) {
      document.documentElement.classList.remove("features-core-pre-anim");
      return;
    }

    const eyebrow = section.querySelector<HTMLElement>("[data-features-core-eyebrow]");
    const headline = section.querySelector<HTMLElement>("[data-features-core-headline]");
    const subhead = section.querySelector<HTMLElement>("[data-features-core-subhead]");
    const slider = section.querySelector<HTMLElement>("[data-features-core-slider]");
    const loader = section.querySelector<HTMLElement>("[data-features-core-loader]");
    const loaderSvg = section.querySelector<SVGElement>("[data-features-core-loader-svg]");

    const eyebrowSplit = eyebrow ? new SplitText(eyebrow, { type: "lines", mask: "lines" }) : null;
    const headlineSplit = headline ? new SplitText(headline, { type: "lines", mask: "lines" }) : null;
    const subheadSplit = subhead ? new SplitText(subhead, { type: "lines", mask: "lines" }) : null;

    if (eyebrowSplit) gsap.set(eyebrowSplit.lines, { yPercent: 110 });
    if (headlineSplit) gsap.set(headlineSplit.lines, { yPercent: 110 });
    if (subheadSplit) gsap.set(subheadSplit.lines, { yPercent: 110 });
    /* Card entrance is handled separately (Edgar will define). Skip the
       slider opacity/y intro here. */
    if (loader) gsap.set(loader, { opacity: 0, scale: 0.6, transformOrigin: "center" });

    document.documentElement.classList.remove("features-core-pre-anim");

    const tl = gsap.timeline({
      scrollTrigger: { trigger: section, comeca: "top 80%", once: true },
    });
    if (eyebrowSplit) tl.to(eyebrowSplit.lines, { yPercent: 0, duration: 0.65, ease: "eagleReveal", stagger: 0.05 }, 0);
    if (headlineSplit) tl.to(headlineSplit.lines, { yPercent: 0, duration: 0.9, ease: "eagleReveal", stagger: 0.1 }, 0.15);
    if (subheadSplit) tl.to(subheadSplit.lines, { yPercent: 0, duration: 0.7, ease: "eagleReveal", stagger: 0.05 }, 0.4);
    if (loader) tl.to(loader, { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(1.5)" }, 0.6);
    /* Card intro disabled — Edgar will define a custom entrance. */

    // Eagle logo loader rotation — disabled per Edgar. Logo stays
    // static (with its existing accent-glow) instead of spinning.

    // Slider state machine — same pattern as the Sobre / Nossa Values slider.
    const dataEl = section.querySelector<HTMLElement>("[data-features-core-data]");
    const data = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
    const pills = section.querySelectorAll<HTMLButtonElement>("[data-features-core-pill]");
    const stages = section.querySelectorAll<HTMLElement>("[data-features-core-stage]");
    const counterEl = section.querySelector<HTMLElement>("[data-features-core-counter]");
    const titleEl = section.querySelector<HTMLElement>("[data-features-core-title]");
    const bodyEl = section.querySelector<HTMLElement>("[data-features-core-body]");
    const bulletsEl = section.querySelector<HTMLElement>("[data-features-core-bullets]");

    const AUTO_MS = 5500;
    const ANIM_DUR = 0.5;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let animating = false;

    const renderBullets = (idx: number) => {
      if (!bulletsEl) return;
      bulletsEl.innerHTML = data[idx].bullets
        .map((b: string) => `<li class="flex items-center gap-[0.75rem]"><span class="size-[0.5rem] shrink-0 bg-[#fdff22]" aria-hidden="true"></span><span class="text-[0.75rem] leading-[1.2857] text-white/60">${b}</span></li>`)
        .join("");
    };

    const updateUI = (idx: number) => {
      pills.forEach((p, i) => {
        p.className =
          i === idx
            ? "accent-glow-active h-[0.5rem] w-[2.5rem] cursor-pointer bg-[#fdff22] transition-all duration-300"
            : "size-[0.5rem] cursor-pointer bg-[#303030] transition-all duration-300 hover:bg-[#505050]";
      });
      stages.forEach((s, i) => s.setAttribute("data-active", i === idx ? "true" : "false"));
      if (counterEl) counterEl.textContent = String(idx + 1).padStart(2, "0");
      if (titleEl) titleEl.textContent = data[idx].title;
      if (bodyEl) bodyEl.textContent = data[idx].body;
      renderBullets(idx);
    };

    const goTo = (idx: number, dir: 1 | -1 = 1) => {
      if (animating || idx === current || !data[idx]) return;
      animating = true;
      const offset = dir === 1 ? -32 : 32;
      const copyCol = section.querySelector<HTMLElement>("[data-features-core-title]")?.parentElement;
      const target = copyCol || section;
      gsap.to(target, {
        x: offset,
        opacity: 0,
        duration: ANIM_DUR / 2,
        ease: "power2.in",
        onComplete: () => {
          current = idx;
          updateUI(idx);
          gsap.fromTo(
            target,
            { x: -offset, opacity: 0 },
            { x: 0, opacity: 1, duration: ANIM_DUR / 2, ease: "power2.out", onComplete: () => { animating = false; } },
          );
        },
      });
    };

    const comeca = () => {
      stop();
      timer = setInterval(() => {
        goTo((current + 1) % data.length, 1);
      }, AUTO_MS);
    };
    const stop = () => {
      if (timer) { clearInterval(timer); timer = null; }
    };

    pills.forEach((pill, i) =>
      pill.addEventListener("click", () => {
        const dir: 1 | -1 = i > current ? 1 : -1;
        goTo(i, dir);
        comeca();
      }),
    );
    section.addEventListener("mouseenter", stop);
    section.addEventListener("mouseleave", comeca);

    ScrollTrigger.create({
      trigger: section,
      comeca: "top 90%",
      end: "bottom 10%",
      onEnter: comeca,
      onEnterBack: comeca,
      onLeave: stop,
      onLeaveBack: stop,
    });
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initCore);
  else initCore();

  /* ---------- Core Recursos sticky sizing + release sync ----------
     1. CSS variables: card sticky_top + card_h based on live nav + title.
     2. mx-auto wrapper gets an explicit height that ends `(card_h + 2rem)`
        BEFORE the stack actually ends. That makes the sticky header
        release at the same scroll moment as the last sticky card.
     3. Section padding-bottom is extended by the same offset so the
        next section still comecas 5rem after the stack's visual bottom. */
  const initCoreSticky = () => {
    const section = document.querySelector<HTMLElement>("[data-features-core]");
    const header = document.querySelector<HTMLElement>("[data-features-core-header]");
    const stack = document.querySelector<HTMLElement>("[data-features-core-stack]");
    const navEl = document.querySelector<HTMLElement>("[data-navbar]");
    const mx = section?.firstElementChild as HTMLElement | null;
    if (!section || !header || !stack || !mx) return;

    const PAD_PX = 32; // 2rem at 16px root
    const SECTION_PB_BASE = 80; // 5rem
    const update = () => {
      // Skip on mobile (sticky disabled below md = 768px).
      if (window.innerWidth < 768) {
        section.style.removeProperty("--features-core-card-top");
        section.style.removeProperty("--features-core-card-h");
        mx.style.height = "";
        section.style.paddingBottom = "";
        return;
      }
      const navH = navEl ? navEl.offsetHeight : 80;
      const titleH = header.offsetHeight;
      const cardTop = navH + PAD_PX + titleH + PAD_PX;
      const cardH = Math.max(320, window.innerHeight - cardTop);
      section.style.setProperty("--features-core-card-top", `${cardTop}px`);
      section.style.setProperty("--features-core-card-h", `${cardH}px`);

      // Release-sync trick: shrink mx-auto's height so it ends `cardH`
      // BEFORE the stack's actual bottom. Stack content visually overflows
      // (overflow:visible) but everything still renders. Cards inside stack
      // remain sticky at their natural positions.
      // releaseOffset = cardH (not cardH + PAD) because the header has
      // `mb-[2rem]` and CSS sticky's "release threshold" uses the element's
      // MARGIN BOX (border-h + margin-bottom), not just border-h. So the
      // 2rem header gap cancels the 2rem header→card gap. Net offset = cardH.
      mx.style.height = "";
      const stackH = stack.offsetHeight;
      const releaseOffset = cardH;
      const mxH = titleH + PAD_PX + stackH - releaseOffset;
      mx.style.height = `${mxH}px`;

      // Section pb compensates so next section sits 5rem below the stack's
      // visual bottom (not the shortened mx-auto bottom).
      section.style.paddingBottom = `${SECTION_PB_BASE + releaseOffset}px`;
    };

    update();
    window.addEventListener("resize", update);
    if (typeof ResizeObserver !== "undefined") {
      const ro = new ResizeObserver(update);
      ro.observe(header);
      if (navEl) ro.observe(navEl);
    }
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initCoreSticky);
  else initCoreSticky();

  /* ---------- Core Recursos Eagle logo scroll-fill ----------
     Yellow stroke is drawn from 0% to 100% as the user scrolls from
     "first card snapped" to "last card snapped". The gray base path
     stays visible the whole time. md+ only — on mobile the logo
     stays fully filled. */
  const initCoreLogoFill = () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fillPath = document.querySelector<SVGPathElement>(".features-core-logo-fill");
    const firstCard = document.querySelector<HTMLElement>("[data-features-core-card-idx='0']");
    const lastCard = document.querySelector<HTMLElement>("[data-features-core-card-idx='3']");
    const section = document.querySelector<HTMLElement>("[data-features-core]");
    if (!fillPath || !firstCard || !lastCard || !section) return;

    // Mobile + reduced motion: just show the logo fully filled.
    if (reduceMotion || window.innerWidth < 768) {
      fillPath.setAttribute("stroke-dashoffset", "0");
      return;
    }

    const getCardTop = () => {
      const v = parseFloat(getComputedStyle(section).getPropertyValue("--features-core-card-top"));
      return isNaN(v) ? 221 : v;
    };

    ScrollTrigger.create({
      trigger: firstCard,
      comeca: () => `top top+=${getCardTop()}`,
      endTrigger: lastCard,
      end: () => `top top+=${getCardTop()}`,
      scrub: 0.5,
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        const offset = 100 * (1 - self.progress);
        fillPath.setAttribute("stroke-dashoffset", offset.toFixed(2));
      },
    });
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initCoreLogoFill);
  else initCoreLogoFill();

  /* ---------- Core Recursos "Saiba mais" scramble hover ----------
     Same block roll-up effect used on Navbar / Hero / AccentButton.
     Wraps just the text span (svg arrow stays unchanged). */
  const initCoreCtaScramble = () => {
    applyScrambleHover("[data-features-core-cta-text]");
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initCoreCtaScramble);
  else initCoreCtaScramble();

  /* ---------- Hero reporting chart — load-triggered (no scroll) ---------- */
  const initHeroReporting = () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wrap = document.querySelector<HTMLElement>("[data-hero-reporting]");
    if (!wrap) return;

    const blocks = wrap.querySelectorAll<HTMLElement>("[data-reporting-block]");
    const values = wrap.querySelectorAll<HTMLElement>("[data-reporting-value]");
    const cells = Array.from(
      wrap.querySelectorAll<HTMLElement>(".reporting-matrix .cell"),
    );

    if (reduceMotion) {
      values.forEach((v) => gsap.set(v, { opacity: 1 }));
      cells.forEach((c, i) => { if (i % 3 !== 0) c.classList.add("is-lit"); });
      return;
    }

    // Initial state: values hidden, all cells unlit
    gsap.set(values, { opacity: 0 });

    // Reveal block values with stagger
    blocks.forEach((_, blockIdx) => {
      const value = blocks[blockIdx].querySelector<HTMLElement>("[data-reporting-value]");
      if (value) {
        gsap.to(value, {
          opacity: 1,
          duration: 0.25,
          ease: "eagleReveal",
          delay: blockIdx * 0.08 + 0.15,
        });
      }
    });

    // Initial wave: light ~70% of cells with fast stagger, each unlights after 1.4-3.4s
    const initialLitCount = Math.floor(cells.length * 0.7);
    const shuffled = [...cells].sort(() => Math.random() - 0.5).slice(0, initialLitCount);
    shuffled.forEach((cell, i) => {
      gsap.delayedCall(0.05 + i * 0.003, () => {
        cell.classList.add("is-lit");
        gsap.delayedCall(1.4 + Math.random() * 2.0, () => cell.classList.remove("is-lit"));
      });
    });

    // Ambient twinkle: light 7-12 random cells every 80ms, each lit 1.4-3.6s
    gsap.delayedCall(0.7, () => {
      setInterval(() => {
        const n = 7 + Math.floor(Math.random() * 6);
        for (let i = 0; i < n; i++) {
          const cell = cells[Math.floor(Math.random() * cells.length)];
          if (!cell.classList.contains("is-lit")) {
            cell.classList.add("is-lit");
            const lifespan = 1400 + Math.random() * 2200;
            setTimeout(() => cell.classList.remove("is-lit"), lifespan);
          }
        }
      }, 80);
    });
  };
  /* (initHeroReporting fires from initCuadrosEntrance below.) */

  /* ---------- Cuadro 2 — Anomaly bar chart on load ---------- */
  const initHeroAnomaly = () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wrap = document.querySelector<HTMLElement>("[data-hero-anomaly]");
    if (!wrap) return;

    const num = wrap.querySelector<HTMLElement>("[data-anomaly-num]");
    const bars = wrap.querySelectorAll<HTMLElement>("[data-ano-bar]");
    const axis = wrap.querySelectorAll<HTMLElement>("[data-ls-axis]");

    if (reduceMotion) {
      if (num) num.textContent = (parseInt(num.dataset.target || "124", 10)).toLocaleString("en-US");
      bars.forEach((b) => {
        const t = parseFloat(b.dataset.targetH || "0.3");
        b.style.height = `${t * 100}%`;
      });
      gsap.set(axis, { opacity: 1, y: 0 });
      return;
    }

    // Initial state
    gsap.set(bars, { height: 0 });
    gsap.set(axis, { opacity: 0, y: 4 });
    if (num) num.textContent = "0";

    const tl = gsap.timeline();

    // Number count-up
    if (num) {
      const target = parseInt(num.dataset.target || "124", 10);
      const proxy = { val: 0 };
      tl.to(proxy, {
        val: target,
        duration: 0.6,
        ease: "eagleReveal",
        snap: { val: 1 },
        onUpdate: () => {
          num.textContent = proxy.val.toLocaleString("en-US");
        },
      }, 0);
    }

    // Bars grow from bottom, staggered left → right
    bars.forEach((bar, i) => {
      const targetH = parseFloat(bar.dataset.targetH || "0.3");
      tl.to(bar, {
        height: `${targetH * 100}%`,
        duration: 0.55,
        ease: "eagleStructure",
      }, 0.15 + i * 0.08);
    });

    // Axis fades in after bars
    if (axis.length) {
      tl.to(axis, {
        opacity: 1,
        y: 0,
        duration: 0.3,
        ease: "eagleReveal",
        stagger: 0.03,
      }, 0.85);
    }
  };
  /* (initHeroAnomaly fires from initCuadrosEntrance below.) */

  /* ---------- Cuadro 3 — Lock + trust marquees on load ---------- */
  const initHeroTrust = () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wrap = document.querySelector<HTMLElement>("[data-hero-trust]");
    if (!wrap) return;

    const lockCells = wrap.querySelectorAll<HTMLElement>(".lock-cell.on");
    const marquees = wrap.querySelectorAll<HTMLElement>("[data-trust-marquee]");

    if (reduceMotion) {
      gsap.set(lockCells, { opacity: 1, scale: 1 });
      gsap.set(marquees, { opacity: 1, y: 0 });
      return;
    }

    // Initial state
    gsap.set(lockCells, { opacity: 0, scale: 0.6, transformOrigin: "center" });
    gsap.set(marquees, { opacity: 0, y: 12 });

    const tl = gsap.timeline();

    // Lock builds pixel-by-pixel from center outward
    if (lockCells.length) {
      tl.to(lockCells, {
        opacity: 1,
        scale: 1,
        duration: 0.04,
        ease: "eagleDecor",
        stagger: { each: 0.003, from: "center" },
      }, 0);
    }
    // Marquees fade up after lock builds
    if (marquees.length) {
      tl.to(marquees, {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "eagleReveal",
        stagger: 0.12,
      }, 0.6);
    }
  };
  /* (initHeroTrust fires from initCuadrosEntrance below.) */

  /* ---------- Cuadros staircase entrance — back-to-front stagger ----------
     Each cuadro is hidden via the `features-cuadros-pre-anim` CSS class
     (visibility: hidden) at first paint. JS flips visibility back per
     cuadro on a stagger so they appear 1×1 at their final size, with no
     scale, fade, or easing. Reduce-motion users get all 3 visible at once. */
  const initCuadrosEntrance = () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const c1 = document.querySelector<HTMLElement>(".hero-reporting-wrap");
    const c2 = document.querySelector<HTMLElement>(".hero-anomaly-wrap");
    const c3 = document.querySelector<HTMLElement>(".hero-trust-wrap");
    if (!c1 || !c2 || !c3) return;

    if (reduceMotion) {
      document.documentElement.classList.remove("features-cuadros-pre-anim");
      initHeroTrust();
      initHeroAnomaly();
      initHeroReporting();
      return;
    }

    const STAGGER = 0.5;

    // Mirror the CSS pre-anim state inline so it survives the class removal,
    // then drop the class. Each cuadro then becomes visible on its own delay.
    gsap.set([c1, c2, c3], { visibility: "hidden" });
    document.documentElement.classList.remove("features-cuadros-pre-anim");

    gsap.delayedCall(0, () => {
      c3.style.visibility = "visible";
      initHeroTrust();
    });
    gsap.delayedCall(STAGGER, () => {
      c2.style.visibility = "visible";
      initHeroAnomaly();
    });
    gsap.delayedCall(STAGGER * 2, () => {
      c1.style.visibility = "visible";
      initHeroReporting();
    });
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initCuadrosEntrance);
  else initCuadrosEntrance();

  /* ---------- Cuadros responsive scaling ----------
     Below the design width, scale the cuadros group so it fits the column.
     At the design width or larger, no scaling (cap at 1). */
  const initCuadrosEscale = () => {
    const stack = document.querySelector<HTMLElement>("[data-features-hero-stack]");
    if (!stack) return;
    const REFERENCE_WIDTH = 528; // px — column width at design viewport (1280)
    const update = () => {
      const w = stack.clientWidth;
      const scale = Math.min(1, w / REFERENCE_WIDTH);
      stack.style.setProperty("--cuadros-scale", scale.toFixed(4));
    };
    update();
    if (typeof ResizeObserver !== "undefined") {
      const ro = new ResizeObserver(update);
      ro.observe(stack);
    } else {
      window.addEventListener("resize", update);
    }
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initCuadrosEscale);
  else initCuadrosEscale();

</script>
