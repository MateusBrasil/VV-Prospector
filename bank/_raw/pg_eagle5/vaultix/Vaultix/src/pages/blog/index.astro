---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HalftoneImage from "../../components/HalftoneImage.astro";
import EagleMarker from "../../components/VaultixMarker.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featured = posts[0];
const rest = posts.slice(1);

// Same 3 halftone sources used in Inicio BlogsSection — rotate per card.
const halftoneSrc = (i: number) => `/blog/halftone-source-0${(i % 3) + 1}-bw.webp`;

const categories = ["All", "Engenharia", "Produto", "Codigo aberto"];

const fmt = (d: Data) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<BaseLayout title="Blog — Eagle" description="Engenharia deep-dives, product updates, and notes from the team.">
  {/* ========================================================================
       SECTION 01 — Hero (Figma 1:15114): title + featured post
     ======================================================================== */}
  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("blog-list-hero-pre-anim");
    }
  </script>

  <section class="relative bg-[var(--color-bg)] pb-[3rem] md:pb-[2.5rem]" data-blog-list-hero>
    {/* Title block — hug content. Top edge calza con el navbar sticky
        (que ya provee la línea horizontal top via su border-b). Las verticales
        nacen al ras del navbar bottom. Los markers top cruzan visualmente la
        línea del navbar — z-50 para verse encima de éste (z-40). */}
    <div class="relative mx-auto w-full max-w-[70.5rem] px-4 lg:px-0" data-blog-list-hero-block>
      <span
        class="pointer-events-none absolute left-0 top-0 z-10 hidden h-full w-px bg-[var(--color-border)] lg:block"
        data-blog-list-hero-line="left"
        aria-hidden="true"></span>
      <span
        class="pointer-events-none absolute right-0 top-0 z-10 hidden h-full w-px bg-[var(--color-border)] lg:block"
        data-blog-list-hero-line="right"
        aria-hidden="true"></span>
      <span
        class="pointer-events-none absolute bottom-0 left-1/2 hidden h-px w-screen -translate-x-1/2 bg-[var(--color-border)] lg:block"
        data-blog-list-hero-line="bottom"
        aria-hidden="true"></span>

      {/* Top corner markers — navbar-adjacent special offset:
          `top: calc(-0.5rem + 0.5px)` shifts the marker bar 1px below the
          navbar's border-b line (adjacent, not aligned). Stay at z-20 so
          the navbar (z-40) stays the principal layer above everything.
          Bottom corners use the normal `-0.5rem - 0.5px` offset. */}
      <EagleMarker type="tip-down" data-blog-list-hero-tmark class="absolute left-4 top-[calc(-0.5rem_+_0.5px)] z-20 hidden -translate-x-1/2 lg:left-0 lg:block" />
      <EagleMarker type="tip-down" data-blog-list-hero-tmark class="absolute right-4 top-[calc(-0.5rem_+_0.5px)] z-20 hidden translate-x-1/2 lg:right-0 lg:block" />
      <EagleMarker type="tip-up" data-blog-list-hero-tmark class="absolute bottom-[calc(-0.5rem_-_0.5px)] left-4 z-20 hidden -translate-x-1/2 lg:left-0 lg:block" />
      <EagleMarker type="tip-up" data-blog-list-hero-tmark class="absolute bottom-[calc(-0.5rem_-_0.5px)] right-4 z-20 hidden translate-x-1/2 lg:right-0 lg:block" />

      <div class="flex flex-col items-comeca gap-[1rem] pt-[3rem] pb-[2rem] md:pt-[4.5rem] lg:px-[2.5rem] lg:pb-[4.5rem]">
        <span
          class="font-mono text-[0.875rem] uppercase leading-[1.2857] tracking-[1.68px] text-[#fdff22]"
          data-blog-list-hero-eyebrow
        >
          [ blog ]
        </span>
        <h1
          class="max-w-[40rem] font-mono text-[2.75rem] font-normal uppercase leading-[1.05] tracking-[0.2rem] text-white md:max-w-none md:text-[3.5rem] md:tracking-[0.42rem]"
          data-blog-list-hero-headline
        >
          Field notes from running models at scale
        </h1>
        <p
          class="max-w-[28rem] font-mono text-[0.875rem] uppercase leading-[1.4] tracking-[1.68px] text-white/60"
          data-blog-list-hero-subhead
        >
          Engenharia deep-dives, product updates, and notes from the team.
        </p>
      </div>
    </div>

    {/* Recursod post — 2 columns proportional (2fr image, 1fr text). The mid
        vertical divider sits at 2/3 of the container width so it tracks the
        column boundary at any viewport. */}
    {featured && (
      <div class="relative mx-auto w-full max-w-[70.5rem] px-4 lg:px-0" data-blog-list-featured-wrap>
        <span
          class="pointer-events-none absolute left-4 top-0 z-10 hidden h-full w-px bg-[var(--color-border)] lg:left-0 lg:block"
          data-blog-list-featured-line="left"
          aria-hidden="true"></span>
        <span
          class="pointer-events-none absolute left-[calc(((100%_-_2rem)*_2/3)_+_1rem)] top-0 z-10 hidden h-full w-px bg-[var(--color-border)] lg:left-2/3 lg:block"
          data-blog-list-featured-line="mid"
          aria-hidden="true"></span>
        <span
          class="pointer-events-none absolute right-4 top-0 z-10 hidden h-full w-px bg-[var(--color-border)] lg:right-0 lg:block"
          data-blog-list-featured-line="right"
          aria-hidden="true"></span>
        <span
          class="pointer-events-none absolute bottom-0 left-1/2 hidden h-px w-screen -translate-x-1/2 bg-[var(--color-border)] lg:block"
          data-blog-list-featured-line="bottom"
          aria-hidden="true"></span>

        {/* 4 outer corners + 2 mid (top/bottom of mid-vertical). Normal
            offset `-0.5rem - 0.5px` for both top and bottom — these markers
            sit on the bordered block edges, not on the navbar. */}
        <EagleMarker type="tip-down" data-blog-list-featured-tmark class="absolute left-4 top-[calc(-0.5rem_-_0.5px)] z-20 hidden -translate-x-1/2 lg:left-0 lg:block" />
        <EagleMarker type="tip-down" data-blog-list-featured-tmark class="absolute right-4 top-[calc(-0.5rem_-_0.5px)] z-20 hidden translate-x-1/2 lg:right-0 lg:block" />
        <EagleMarker type="tip-up" data-blog-list-featured-tmark class="absolute bottom-[calc(-0.5rem_-_0.5px)] left-4 z-20 hidden -translate-x-1/2 lg:left-0 lg:block" />
        <EagleMarker type="tip-up" data-blog-list-featured-tmark class="absolute bottom-[calc(-0.5rem_-_0.5px)] right-4 z-20 hidden translate-x-1/2 lg:right-0 lg:block" />
        <EagleMarker type="tip-down" data-blog-list-featured-tmark class="absolute left-2/3 top-[calc(-0.5rem_-_0.5px)] z-20 hidden -translate-x-1/2 lg:block" />
        <EagleMarker type="tip-up" data-blog-list-featured-tmark class="absolute bottom-[calc(-0.5rem_-_0.5px)] left-2/3 z-20 hidden -translate-x-1/2 lg:block" />

        <a
          href={`/blog/${featured.id}`} class="blog-card group grid grid-cols-1 outline-none focus-visible:ring-1 focus-visible:ring-[#fdff22] md:grid-cols-[2fr_1fr]"
          data-blog-list-featured
        >
          {/* Image — fills full height of the card (matches text column height
              via grid stretch). object-cover keeps the halftone composition. */}
          <div class="relative aspect-[767/401] w-full overflow-hidden md:aspect-auto md:h-full">
            <HalftoneImage src={halftoneSrc(0)} alt={featured.data.title} />
          </div>
          <div class="flex flex-col justify-between gap-[1.5rem] p-[1.25rem] max-md:px-0 lg:p-[2.5rem]">
            <div class="flex flex-col gap-[0.75rem] font-mono uppercase">
              <div class="flex flex-col gap-[0.25rem] text-[0.875rem] leading-[1.2857] tracking-[1.68px] text-white/60 lg:flex-row lg:items-center lg:gap-[0.75rem]">
                <span class="text-[#b5d2ff]">{featured.data.category}</span>
                <span class="hidden size-[0.25rem] shrink-0 bg-white/40 lg:inline-block" aria-hidden="true"></span>
                <time class="hidden lg:inline">{fmt(featured.data.date)}</time>
              </div>
              <h2 class="blog-card__title text-[1.5rem] font-normal uppercase leading-[1.2] tracking-normal text-white">
                {featured.data.title}
              </h2>
              <p class="text-[0.875rem] leading-[1.4] normal-case text-white/60">
                {featured.data.description}
              </p>
            </div>
            <span class="blog-card__readmore inline-flex w-fit items-center gap-[0.375rem] font-mono text-[0.875rem] font-bold uppercase leading-[1.4286] tracking-[1.68px] text-[#fdff22]">
              <span data-scramble-hover>Ler mais</span>
              <span class="blog-card__readmore-arrow" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      </div>
    )}
  </section>

  <style>
    .blog-list-hero-pre-anim [data-blog-list-hero-eyebrow],
    .blog-list-hero-pre-anim [data-blog-list-hero-headline],
    .blog-list-hero-pre-anim [data-blog-list-hero-subhead],
    .blog-list-hero-pre-anim [data-blog-list-featured] {
      visibility: hidden;
    }
    .blog-list-hero-pre-anim [data-blog-list-hero-line],
    .blog-list-hero-pre-anim [data-blog-list-hero-tmark],
    .blog-list-hero-pre-anim [data-blog-list-featured-line],
    .blog-list-hero-pre-anim [data-blog-list-featured-tmark] {
      opacity: 0;
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { SplitText } from "gsap/SplitText";
    import { registerEagleEases } from "../../lib/eases";
    import { applyScrambleHover } from "../../lib/scramble-hover";

    gsap.registerPlugin(ScrollTrigger, SplitText);
    registerEagleEases();
    // Apply char roll-up to all "Ler mais" labels on this page.
    applyScrambleHover("[data-scramble-hover]");

    const init = () => {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) {
        document.documentElement.classList.remove("blog-list-hero-pre-anim");
        return;
      }
      const section = document.querySelector<HTMLElement>("[data-blog-list-hero]");
      if (!section) return;

      const eyebrow = section.querySelector<HTMLElement>("[data-blog-list-hero-eyebrow]");
      const headline = section.querySelector<HTMLElement>("[data-blog-list-hero-headline]");
      const subhead = section.querySelector<HTMLElement>("[data-blog-list-hero-subhead]");
      const featured = section.querySelector<HTMLElement>("[data-blog-list-featured]");
      const lines = gsap.utils.toArray<HTMLElement>("[data-blog-list-hero-line], [data-blog-list-featured-line]", section);
      const tmarks = gsap.utils.toArray<SVGElement>(
        "[data-blog-list-hero-tmark], [data-blog-list-featured-tmark]",
        section
      );

      const eyebrowSplit = eyebrow ? new SplitText(eyebrow, { type: "lines", mask: "lines" }) : null;
      const headlineSplit = headline ? new SplitText(headline, { type: "lines", mask: "lines" }) : null;
      const subheadSplit = subhead ? new SplitText(subhead, { type: "lines", mask: "lines" }) : null;

      if (eyebrowSplit) gsap.set(eyebrowSplit.lines, { yPercent: 110 });
      if (headlineSplit) gsap.set(headlineSplit.lines, { yPercent: 110 });
      if (subheadSplit) gsap.set(subheadSplit.lines, { yPercent: 110 });
      if (featured) gsap.set(featured, { opacity: 0 });
      lines.forEach((l) => {
        const o = l.dataset.blogListHeroLine || l.dataset.blogListRecursodLine;
        if (o === "top" || o === "mid" || o === "bottom") gsap.set(l, { scaleX: 0, transformOrigin: "left center" });
        else gsap.set(l, { scaleY: 0, transformOrigin: "center top" });
      });
      gsap.set(tmarks, { opacity: 0, scale: 0.4, transformOrigin: "center" });

      document.documentElement.classList.remove("blog-list-hero-pre-anim");

      const tl = gsap.timeline({
        scrollTrigger: { trigger: section, comeca: "top 80%", once: true },
      });
      tl.to(lines, { scaleX: 1, scaleY: 1, duration: 0.8, ease: "eagleStructure", stagger: 0.04 }, 0);
      tl.to(tmarks, { opacity: 1, scale: 1, duration: 0.4, ease: "eagleDecor", stagger: 0.06 }, 0.55);
      if (eyebrowSplit) tl.to(eyebrowSplit.lines, { yPercent: 0, duration: 0.65, ease: "eagleReveal", stagger: 0.05 }, 0.3);
      if (headlineSplit) tl.to(headlineSplit.lines, { yPercent: 0, duration: 0.9, ease: "eagleReveal", stagger: 0.1 }, 0.45);
      if (subheadSplit) tl.to(subheadSplit.lines, { yPercent: 0, duration: 0.7, ease: "eagleReveal", stagger: 0.05 }, 0.65);
      if (featured) tl.to(featured, { opacity: 1, duration: 0.8, ease: "eagleReveal" }, 0.7);
    };

    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
    else init();
  </script>

  {/* ========================================================================
       SECTION 02 — All posts grid (Figma 1:15493)
     ======================================================================== */}
  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("blog-list-grid-pre-anim");
    }
  </script>

  <section class="relative bg-[var(--color-bg)] py-[3rem] md:pt-[2.5rem] md:pb-[5rem]" data-blog-list-grid>
    <div class="mx-auto w-full max-w-[70.5rem] px-4 lg:px-0">
      {/* Categoria filter pills — left-aligned, only the pill row gets bg */}
      <div
        class="inline-flex w-fit max-w-full flex-wrap items-center gap-[0.5rem] bg-[#1c1c1c] p-[0.25rem]"
        role="tablist"
        aria-label="Filter posts by category"
        data-blog-list-filter
      >
        {
          categories.map((c, i) => {
            const slug = c.toLowerCase().replace(/\s+/g, "-");
            return (
              <button
                type="button"
                role="tab"
                data-blog-filter={slug}
                aria-selected={i === 0 ? "true" : "false"}
                class="blog-filter-pill px-[1rem] py-[0.5rem] font-mono text-[0.875rem] font-normal uppercase leading-[1.2857] tracking-[1.68px] transition-colors transition-[filter] duration-300"
              >
                {c}
              </button>
            );
          })
        }
      </div>

      {/* Post grid: 2 columns horizontal cards, divided by border. No corner
          markers on this section — the hover bg-tint carries the affordance
          (same pattern as Inicio BlogsSection). */}
      <div
        class="mt-[2.5rem] grid grid-cols-1 divide-y divide-[var(--color-border)] border border-[var(--color-border)] sm:grid-cols-2 sm:divide-x"
        data-blog-list-grid-cards
      >
        {
          rest.map((p, idx) => (
            <a
              href={`/blog/${p.id}`} class="blog-card group grid grid-cols-1 items-stretch gap-[1rem] p-[1.25rem] outline-none focus-visible:ring-1 focus-visible:ring-[#fdff22] md:grid-cols-[1fr_35%]"
              data-blog-list-card
              data-card-category={p.data.category.toLowerCase().replace(/\s+/g, "-")}
            >
              <div class="flex min-w-0 flex-col justify-between gap-[1.25rem] py-[0.5rem]">
                <div class="flex flex-col gap-[0.5rem] font-mono uppercase">
                  <div class="flex flex-wrap items-center gap-[0.5rem] text-[0.75rem] leading-[1.2857] tracking-[1.68px] text-white/60">
                    <span class="text-[#b5d2ff]">{p.data.category}</span>
                    <span class="hidden size-[0.25rem] shrink-0 bg-white/40 lg:inline-block" aria-hidden="true"></span>
                    <time class="hidden lg:inline">{fmt(p.data.date)}</time>
                  </div>
                  <h2 class="blog-card__title text-[1.125rem] font-normal leading-[1.25] tracking-normal text-white">
                    {p.data.title}
                  </h2>
                </div>
                <span class="blog-card__readmore inline-flex w-fit items-center gap-[0.375rem] font-mono text-[0.875rem] font-bold uppercase leading-[1.4286] tracking-[1.68px] text-[#fdff22]">
                  <span data-scramble-hover>Ler mais</span>
                  <span class="blog-card__readmore-arrow" aria-hidden="true">→</span>
                </span>
              </div>
              {/* Image — 35% of card width, square aspect ratio. Fluid both
                  dimensions, never overflows. */}
              <div class="relative order-first aspect-square w-full self-center overflow-hidden md:order-none">
                <HalftoneImage src={halftoneSrc(idx + 1)} alt={p.data.title} />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    .blog-list-grid-pre-anim [data-blog-list-filter],
    .blog-list-grid-pre-anim [data-blog-list-card] {
      visibility: hidden;
    }

    /* When the active filter leaves only one card matching, collapse the grid
       so the lone card stays in the left column at its normal width — no
       dangling empty right column with floating borders. */
    @media (min-width: 640px) {
      [data-blog-list-grid-cards][data-blog-grid-mode="single"] {
        width: 50%;
        grid-template-columns: 1fr !important;
        margin-right: auto;
      }
    }

    /* Filter pills — navlink-style: white/60 default, hover yellow + glow,
       active pill = yellow bg with strong glow. */
    .blog-filter-pill {
      color: rgba(255, 255, 255, 0.6);
    }
    @media (hover: hover) and (pointer: fine) {
      .blog-filter-pill[aria-selected="false"]:hover {
        color: #fdff22;
        filter:
          drop-shadow(0 0 2px rgba(253, 255, 34, 0.55))
          drop-shadow(0 0 6px rgba(253, 255, 34, 0.18));
      }
    }
    .blog-filter-pill[aria-selected="true"] {
      background: #fdff22;
      color: #11130e;
      font-weight: 700;
      box-shadow:
        0 0 8px rgba(253, 255, 34, 0.9),
        0 0 24px rgba(253, 255, 34, 0.5),
        0 0 48px rgba(253, 255, 34, 0.2);
    }

    /* Card hover — title stays white, no bg shift. The affordance is
       carried entirely by the yellow Read-more: glow + char roll-up +
       arrow revelar. */
    .blog-card .blog-card__readmore {
      transition: filter 0.3s ease;
    }
    .blog-card .blog-card__readmore-arrow {
      display: inline-block;
      max-width: 0;
      opacity: 0;
      overflow: hidden;
      white-space: nowrap;
      transition:
        max-width 0.35s cubic-bezier(0.7, 0, 0.2, 1),
        opacity 0.35s ease,
        margin-left 0.35s cubic-bezier(0.7, 0, 0.2, 1);
    }
    @media (hover: hover) and (pointer: fine) {
      .blog-card:hover .blog-card__readmore {
        filter:
          drop-shadow(0 0 4px rgba(253, 255, 34, 0.85))
          drop-shadow(0 0 10px rgba(253, 255, 34, 0.5))
          drop-shadow(0 0 18px rgba(253, 255, 34, 0.2));
      }
      .blog-card:hover .blog-card__readmore-arrow {
        max-width: 1.25rem;
        opacity: 1;
        margin-left: 0.375rem;
      }
    }
  </style>

  <script>
    import { gsap as gsapG } from "gsap";
    import { ScrollTrigger as STG } from "gsap/ScrollTrigger";
    import { registerEagleEases as regG } from "../../lib/eases";

    gsapG.registerPlugin(STG);
    regG();

    const initGrid = () => {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) {
        document.documentElement.classList.remove("blog-list-grid-pre-anim");
        return;
      }
      const section = document.querySelector<HTMLElement>("[data-blog-list-grid]");
      if (!section) return;
      const filter = section.querySelector<HTMLElement>("[data-blog-list-filter]");
      const cards = gsapG.utils.toArray<HTMLElement>("[data-blog-list-card]", section);
      if (filter) gsapG.set(filter, { opacity: 0 });
      gsapG.set(cards, { opacity: 0 });
      document.documentElement.classList.remove("blog-list-grid-pre-anim");
      const tl = gsapG.timeline({
        scrollTrigger: { trigger: section, comeca: "top 85%", once: true },
      });
      if (filter) tl.to(filter, { opacity: 1, duration: 0.6, ease: "eagleReveal" }, 0);
      tl.to(cards, { opacity: 1, duration: 0.7, ease: "eagleReveal", stagger: 0.08 }, 0.2);

      // Categoria filter behavior — only swap aria-selected; styles in CSS.
      // When the filter narrows to a single card we collapse the grid so the
      // remaining card stays left-aligned without an empty right column
      // showing dangling borders.
      const buttons = section.querySelectorAll<HTMLButtonElement>("[data-blog-filter]");
      const grid = section.querySelector<HTMLElement>("[data-blog-list-grid-cards]");

      const updateGridMode = () => {
        if (!grid) return;
        const visible = cards.filter(
          (c) => (c as HTMLElement).style.display !== "none"
        ).length;
        if (visible === 1) {
          grid.dataset.blogGridMode = "single";
        } else {
          delete grid.dataset.blogGridMode;
        }
      };

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.dataset.blogFilter;
          buttons.forEach((b) => {
            b.setAttribute("aria-selected", b === btn ? "true" : "false");
          });
          cards.forEach((card) => {
            const matches = target === "all" || card.dataset.cardCategoria === target;
            (card as HTMLElement).style.display = matches ? "" : "none";
          });
          updateGridMode();
        });
      });
    };

    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initGrid);
    else initGrid();
  </script>
</BaseLayout>
