  <script>
    // Mobile-only team slider: inject prev/next arrows + counter, sync the
    // [data-active] card based on which one is centered in the scroll-snap track.
    const initTeamSlider = () => {
      const track = document.querySelector<HTMLElement>("[data-about-team-cards]");
      if (!track) return;
      const cards = Array.from(track.querySelectorAll<HTMLElement>("[data-about-team-card]"));
      if (!cards.length) return;

      // Inject nav (counter + arrows) once
      const nav = document.createElement("div");
      nav.className = "tm-mobile-nav";
      nav.innerHTML = `
        <button type="button" class="tm-arrow tm-arrow--prev" aria-label="Previous">
          <svg viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
            <path d="M11.25 5.25L7.5 9l3.75 3.75V5.25z" />
          </svg>
        </button>
        <button type="button" class="tm-arrow tm-arrow--next" aria-label="Next">
          <svg viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
            <path d="M7.5 5.25L11.25 9 7.5 12.75V5.25z" />
          </svg>
        </button>
      `;
      track.parentElement?.appendChild(nav);

      const prev = nav.querySelector<HTMLButtonElement>(".tm-arrow--prev");
      const next = nav.querySelector<HTMLButtonElement>(".tm-arrow--next");

      const isMobile = () => window.matchMedia("(max-width: 639px)").matches;

      const indexOfCentered = () => {
        if (!isMobile()) return -1;
        const center = track.scrollLeft + track.clientWidth / 2;
        let best = 0;
        let bestDist = Infinity;
        cards.forEach((c, i) => {
          const cc = c.offsetLeft + c.offsetWidth / 2;
          const d = Math.abs(cc - center);
          if (d < bestDist) { bestDist = d; best = i; }
        });
        return best;
      };

      // Fire synthetic mouseenter/mouseleave so HalftoneImage's hover loop
      // (pulse + glow + spread) comecas/stops on the active card. The events
      // are dispatched at the card itself; HalftoneImage listens on its
      // closest <a>/<article> ancestor, which is the card.
      const fireHover = (card: HTMLElement, type: "mouseenter" | "mouseleave") => {
        card.dispatchEvent(new MouseEvent(type, { bubbles: false }));
      };

      const setActive = (idx: number) => {
        cards.forEach((c, i) => {
          const wasActive = c.dataset.active === "true";
          const willBeActive = i === idx;
          if (willBeActive && !wasActive) {
            c.dataset.active = "true";
            fireHover(c, "mouseenter");
          } else if (!willBeActive && wasActive) {
            delete c.dataset.active;
            fireHover(c, "mouseleave");
          }
        });
        if (prev) prev.disabled = idx <= 0;
        if (next) next.disabled = idx >= cards.length - 1;
      };

      // Block real mouse hover on mobile so HalftoneImage only reacts to our
      // synthetic events (which have isTrusted=false). User-generated mouse
      // events on a touch device shouldn't trigger the hover loop.
      cards.forEach((c) => {
        (["mouseenter", "mouseleave"] as const).forEach((t) => {
          c.addEventListener(
            t,
            (e) => {
              if (!isMobile()) return;
              if (e.isTrusted) e.stopImmediatePropagation();
            },
            { capture: true },
          );
        });
      });

      const scrollToIdx = (i: number) => {
        const target = cards[Math.max(0, Math.min(cards.length - 1, i))];
        if (!target) return;
        const left = target.offsetLeft + target.offsetWidth / 2 - track.clientWidth / 2;
        track.scrollTo({ left, behavior: "smooth" });
      };

      prev?.addEventListener("click", () => {
        const i = indexOfCentered();
        scrollToIdx(Math.max(0, i - 1));
      });
      next?.addEventListener("click", () => {
        const i = indexOfCentered();
        scrollToIdx(Math.min(cards.length - 1, i + 1));
      });

      // While scrolling: clear any active card so the effect doesn't trail
      // mid-transit. After scroll settles (debounce ~140ms), apply active to
      // the card that snapped into the center.
      let scrollEndTimer = 0;
      const clearActive = () => {
        cards.forEach((c) => {
          if (c.dataset.active === "true") {
            delete c.dataset.active;
            fireHover(c, "mouseleave");
          }
        });
      };
      track.addEventListener(
        "scroll",
        () => {
          if (!isMobile()) return;
          clearActive();
          window.clearTimeout(scrollEndTimer);
          scrollEndTimer = window.setTimeout(() => {
            const i = indexOfCentered();
            if (i >= 0) setActive(i);
          }, 140);
        },
        { passive: true },
      );

      // Initial active state on mobile
      if (isMobile()) setActive(0);
      // Reset on resize crossing the breakpoint
      window.addEventListener("resize", () => {
        if (!isMobile()) {
          cards.forEach((c) => delete c.dataset.active);
        } else if (!cards.some((c) => c.dataset.active)) {
          setActive(indexOfCentered() || 0);
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTeamSlider);
    } else {
      initTeamSlider();
    }
  </script>

  {/* ========================================================================
       SECTION 06 — CTA (shared CtaSection component)
     ======================================================================== */}
  <CtaSection
    headline="Pronta para build the future<br class='hidden lg:inline' /> of your data stack?"
  />
</BaseLayout>
