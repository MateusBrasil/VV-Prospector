            const dir: 1 | -1 = dx < 0 ? 1 : -1;
            const next = (current + dir + valuesData.length) % valuesData.length;
            goTo(next, dir);
            comeca();
          },
          { passive: true },
        );
      }

      section.addEventListener("mouseenter", stop);
      section.addEventListener("mouseleave", comeca);

      // Start the auto-rotate only when the section enters the viewport,
      // and pause when it leaves to avoid background work off-screen.
      STVal.create({
        trigger: section,
        comeca: "top 90%",
        end: "bottom 10%",
        onEnter: comeca,
        onEnterBack: comeca,
        onLeave: stop,
        onLeaveBack: stop,
      });
