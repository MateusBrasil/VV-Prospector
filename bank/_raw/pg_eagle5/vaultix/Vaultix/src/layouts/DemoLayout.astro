---
import "../styles/global.css";
const { title = "Eagle Demo", label = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background: #050505;
      color: #fff;
      font-family: 'Inter', system-ui, sans-serif;
    }
    .demo-label {
      position: fixed;
      top: 12px;
      left: 12px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.4);
      background: rgba(0,0,0,0.6);
      padding: 4px 8px;
      border-radius: 4px;
      backdrop-filter: blur(6px);
      z-index: 9999;
      pointer-events: none;
      text-transform: uppercase;
    }
    .demo-stage {
      min-height: 100vh;
    }
  </style>
</head>
<body>
  {label && <span class="demo-label">{label}</span>}
  <div class="demo-stage">
    <slot />
  </div>
</body>
</html>
