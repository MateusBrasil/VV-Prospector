---
/**
 * EagleMarker — sistema único de marcadores decorativos del template.
 *
 * Solo 2 formas (regla `feedback-eagle-markers-no-inventar.md`):
 *   - "cross" (4 puntas)
 *   - "tip-down/up/right/left" (T con la rama indicada apuntando hacia el centro vacío)
 *
 * Pasa cualquier `data-*` o `class` extra como attribute del <svg>, así el
 * callsite puede targetear los markers para entry animations:
 *   <EagleMarker type="cross" data-blog-list-hero-tmark
 *                  class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2" />
 *
 * Convención de posicionamiento: anchor en (line-intersection-x, line-intersection-y)
 * + `-translate-x-1/2 -translate-y-1/2` para centrar el marker (cuyo cross
 * geométrico está en (8.5, 8) del viewBox 16×16). Evita los offsets viejos
 * `-0.5rem - 1px` que dependen del border-thickness.
 */

type MarkerType =
  | "cross"
  | "tip-down"
  | "tip-up"
  | "tip-right"
  | "tip-left"
  | "corner-tl"
  | "corner-tr"
  | "corner-bl"
  | "corner-br";

interface Props {
  type: MarkerType;
  class?: string;
  [key: string]: unknown;
}

const { type, class: className = "", ...rest } = Astro.props;

const PATHS: Record<MarkerType, string> = {
  cross: "M8 8.5H0V7.5H8V0H9V7.5H16V8.5H9V16H8V8.5Z",
  "tip-down": "M0 7.5H16V8.5H9V16H8V8.5H0Z",
  "tip-up": "M0 8.5H16V7.5H9V0H8V7.5H0Z",
  "tip-right": "M7.5 0H8.5V7.5H16V8.5H8.5V16H7.5Z",
  "tip-left": "M7.5 0H8.5V16H7.5V8.5H0V7.5H7.5Z",
  // Corner brackets — 2-tip L-shapes. Used on cards where each corner
  // gets a marker pointing inward (right + down for top-left, etc.).
  "corner-tl": "M16 7.5V8.5H8.5V16H7.5V7.5Z",
  "corner-tr": "M0 7.5V8.5H7.5V16H8.5V7.5Z",
  "corner-bl": "M16 8.5V7.5H8.5V0H7.5V8.5Z",
  "corner-br": "M0 8.5V7.5H7.5V0H8.5V8.5Z",
};
---

<svg
  class:list={["pointer-events-none h-4 w-4 text-white", className]}
  viewBox="0 0 16 16"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  {...rest}
>
  <path d={PATHS[type]} />
</svg>
