---
const BAR_COUNT = 10;
---

<script is:inline>
  (function () {
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      document.documentElement.classList.add("no-loader");
    } else {
      document.documentElement.classList.add("is-loading");
    }
  })();
</script>

<div class="hero-loader" data-hero-loader aria-hidden="true">
  <div class="hero-loader__inner" data-loader-inner>
    <div class="hero-loader__bars" data-loader-bars>
      {Array.from({ length: BAR_COUNT }).map(() => <span class="hero-loader__bar" />)}
    </div>
    <div class="hero-loader__counter" data-loader-counter>00%</div>
  </div>
</div>

<style is:global>
  html.is-loading,
  html.is-loading body {
    overflow: hidden;
  }

  html.no-loader .hero-loader {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-loader {
      display: none !important;
    }
  }
</style>

<style>
  .hero-loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--color-bg);
    transform: translateZ(0);
    will-change: transform, opacity;
  }

  .hero-loader__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    padding: clamp(1rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .hero-loader__counter {
    align-self: flex-end;
    font-family: var(--font-mono);
    font-size: clamp(3rem, 16vw, 20rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    display: block;
  }
  .hero-loader__counter::after {
    content: "";
    display: block;
    height: 0;
    margin-top: -0.12em;
  }

  .hero-loader__bars {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    height: 37.5vh;
    width: 100%;
  }

  .hero-loader__bar {
    flex: 1;
    min-width: 30px;
    background: rgba(255, 255, 255, 0.12);
    will-change: background-color, box-shadow;
  }

  .hero-loader__bar.is-lit {
    background: var(--color-accent);
    box-shadow:
      0 0 8px rgba(253, 255, 34, 0.9),
      0 0 24px rgba(253, 255, 34, 0.5),
      0 0 48px rgba(253, 255, 34, 0.2);
  }

  /* Mobile: hide the counter, center the bars, constrain to 70vw + 4rem. */
  @media (max-width: 767px) {
    .hero-loader__inner {
      justify-content: center;
      align-items: center;
    }
    .hero-loader__counter {
      display: none;
    }
    .hero-loader__bars {
      width: 70vw;
      height: 4rem;
      gap: 0.375rem;
    }
    .hero-loader__bar {
      min-width: 0;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { registerEagleEases } from "../lib/eases";

  registerEagleEases();

  const html = document.documentElement;
  const loader = document.querySelector<HTMLElement>("[data-hero-loader]");
  const counter = document.querySelector<HTMLElement>("[data-loader-counter]");
  const bars = gsap.utils.toArray<HTMLElement>(
    "[data-loader-bars] .hero-loader__bar"
  );

  const skip = html.classList.contains("no-loader");

  if (!loader || !counter || skip) {
    if (loader) loader.remove();
    html.classList.remove("is-loading");
    window.dispatchEvent(new CustomEvent("eagle:loaded"));
  } else {
    const counterObj = { val: 0 };
    const FILL_DURATION = 1.8;

    let litCount = 0;
    const litThreshold = 100 / bars.length;

    gsap.set(bars, { scaleY: 0, transformOrigin: "top center", opacity: 0 });
    gsap.set(counter, { yPercent: 40, opacity: 0 });

    const tl = gsap.timeline({
      onComplete: () => {
        loader.remove();
        html.classList.remove("is-loading");
        window.dispatchEvent(new CustomEvent("eagle:loaded"));
      },
    });

    tl.to(
      bars,
      {
        scaleY: 1,
        opacity: 1,
        duration: 0.5,
        ease: "eagleStructure",
        stagger: 0.025,
      },
      0
    );
    tl.to(
      counter,
      {
        yPercent: 0,
        opacity: 1,
        duration: 0.5,
        ease: "eagleReveal",
      },
      0.15
    );

    tl.to(
      counterObj,
      {
        val: 100,
        duration: FILL_DURATION,
        ease: "eagleReveal",
        onUpdate: () => {
          const v = Math.round(counterObj.val);
          counter.textContent =
            (v < 100 ? String(v).padStart(2, "0") : "100") + "%";

          while (
            litCount < bars.length &&
            counterObj.val >= (litCount + 1) * litThreshold
          ) {
            bars[litCount].classList.add("is-lit");
            litCount++;
          }
        },
      },
      0.4
    );

    tl.to({}, { duration: 0.25 }, 2.2);

    tl.to(
      loader,
      {
        opacity: 0,
        duration: 0.15,
        ease: "eagleExit",
      },
      2.3
    );
  }
</script>
