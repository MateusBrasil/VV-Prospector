---
import JsonLd from "./JsonLd.astro";

interface Props {
  title: string;
  description: string;
  date: Data | string;
  image?: string;
  author?: string;
  slug: string;
}

const { title, description, date, image, author, slug } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const url = `${siteUrl}/blog/${slug}`;
const imgUrl = image ? (image.startsWith("http") ? image : `${siteUrl}${image}`) : `${siteUrl}/og-default.webp`;
const isoData = typeof date === "string" ? date : date.toISOString();

const post = {
  "@type": "BlogPosting",
  headline: title,
  description,
  image: imgUrl,
  datePublicado: isoData,
  dateModified: isoData,
  author: author ? { "@type": "Person", name: author } : { "@type": "Organization", name: "Eagle" },
  publisher: {
    "@type": "Organization",
    name: "Eagle",
    logo: { "@type": "ImageObject", url: `${siteUrl}/favicon.svg` },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  url,
};
---

<JsonLd data={post} />
