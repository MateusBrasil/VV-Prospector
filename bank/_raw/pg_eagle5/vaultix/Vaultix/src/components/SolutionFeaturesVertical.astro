  /* === Chart 3 — Lock pixel art + Trust marquee === */
  .chart-trust {
    justify-content: space-between;
    padding: 0;
    overflow: hidden;
    position: relative;
  }
  .lock-wrap {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 0.5rem 0;
  }
  .lock-grid {
    width: 9.5rem; /* 152px — match SVG proportions (18 cols × 6.69 + gaps) */
    aspect-ratio: 1 / 1;
    display: grid;
    grid-template-columns: repeat(18, 1fr);
    grid-template-rows: repeat(18, 1fr);
    gap: 0.14rem;
  }
  .lock-cell {
    aspect-ratio: 1 / 1;
    background: transparent;
  }
  .lock-cell.on {
    background: var(--periwinkle);
    box-shadow:
      0 0 8px rgba(95, 92, 255, 1),
      0 0 18px rgba(95, 92, 255, 0.8),
      0 0 36px rgba(95, 92, 255, 0.5),
      0 0 64px rgba(95, 92, 255, 0.25),
      0 0 100px rgba(95, 92, 255, 0.1);
  }
  .trust-marquees {
    display: flex;
    flex-direction: column;
    gap: 0.5674rem;
    padding-bottom: 1.25rem;
  }
  .trust-marquee {
    overflow: hidden;
  }
  .trust-track {
    display: flex;
    gap: 0.5674rem;
    width: max-content;
    animation: trust-scroll 22s linear infinite;
  }
  .trust-track-reverse {
    animation-direction: reverse;
  }
  @keyframes trust-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5674rem;
    padding: 0.5674rem 1.1349rem;
    background: #050505;
    border: 1px solid var(--chart-border);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    line-height: 1.2;
    color: #ffffff;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .trust-dot {
    width: 0.32rem;
    height: 0.32rem;
    background: var(--color-accent);
    flex-shrink: 0;
    box-shadow:
      0 0 4px 0 rgba(253, 255, 34, 0.85),
      0 0 10px 0 rgba(253, 255, 34, 0.4);
    animation: trustDotPulse 1.8s ease-in-out infinite;
  }
  @keyframes trustDotPulse {
    0%, 100% {
      box-shadow:
        0 0 3px 0 rgba(253, 255, 34, 0.6),
        0 0 8px 0 rgba(253, 255, 34, 0.25);
    }
    50% {
      box-shadow:
        0 0 5px 0 rgba(253, 255, 34, 1),
        0 0 12px 0 rgba(253, 255, 34, 0.55),
        0 0 22px 0 rgba(253, 255, 34, 0.25);
    }
  }

  /* === Row 4 — Vector Index gauge (HTML scaffold + SVG ring) === */
  .chart-meter {
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    gap: 1rem;
  }

  /* Top row */
  .meter-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .meter-top-label {
    font-size: 0.7093rem;
    line-height: 1.286;
    letter-spacing: 1.36px;
