</style>

<style is:global>
  /* SFV mobile/tablet slider nav — JS-injected, must use global selectors so
     Astro's scoped attribute-cid doesn't drop these rules.
     Active up to <1024 (mobile + tablet); hidden on desktop. */
  @media (max-width: 1023px) {
    .sfv-mobile-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin: 3rem auto 0;
      padding: 0 1rem 0.5rem;
    }
    .sfv-arrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      border: 0;
      background: var(--color-accent);
      color: #050505;
      cursor: pointer;
      transition: filter 0.18s ease, transform 0.12s ease;
    }
    .sfv-arrow svg {
      width: 1.25rem;
      height: 1.25rem;
    }
    .sfv-arrow:active {
      transform: scale(0.94);
      filter: brightness(0.9);
    }
    .sfv-arrow:disabled {
      background: #343434;
      color: rgba(255, 255, 255, 0.4);
      cursor: not-allowed;
      pointer-events: none;
    }
    .sfv-mobile-count {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 1.125rem;
      letter-spacing: 0.18rem;
      color: rgba(255, 255, 255, 0.95);
      font-variant-numeric: tabular-nums;
      padding: 0 0.5rem;
      text-transform: uppercase;
    }
  }
  @media (min-width: 1024px) {
    .sfv-mobile-nav {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { registerEagleEases } from "../lib/eases";

  gsap.registerPlugin(ScrollTrigger, SplitText);
  registerEagleEases();

  // Mobile: swap the pinned scroll-storyboard for a horizontal scroll-snap
  // slider with two arrow controls. Each feature card is full-width and
  // snaps in turn.
  function wireMobileSlider() {
    const section = document.querySelector<HTMLElement>("[data-sfv-section]");
    const stack = section?.querySelector<HTMLElement>("[data-sfv-stack]");
    if (!section || !stack) return;
    if (stack.dataset.mobileSliderWired === "1") return;
    stack.dataset.mobileSliderWired = "1";

    const features = Array.from(
      stack.querySelectorAll<HTMLElement>("[data-sfv-feature]")
    );

    // Force every chart to its FINAL animated state (no revelar animation on
    // mobile/tablet). Counters show their target numbers, bars sit at full
    // height, meter ring is fully drawn, etc.
    const forceFinalChartState = (feature: HTMLElement) => {
      const type = feature.dataset.chart;
      if (type === "reporting") {
        feature.querySelectorAll<HTMLElement>("[data-reporting-value]").forEach((v) => {
          v.style.opacity = "1";
        });
      } else if (type === "livesystem") {
        feature.querySelectorAll<HTMLElement>("[data-ano-bar]").forEach((bar) => {
          const t = parseFloat(bar.dataset.targetH || "0.3");
          bar.style.height = `${t * 100}%`;
        });
        const num = feature.querySelector<HTMLElement>("[data-anomaly-num]");
        if (num) num.textContent = num.dataset.target || num.textContent || "";
        feature.querySelectorAll<HTMLElement>("[data-ls-axis]").forEach((a) => {
          a.style.opacity = "1";
          a.style.transform = "";
        });
      } else if (type === "lock") {
        feature.querySelectorAll<HTMLElement>("[data-trust-marquee]").forEach((m) => {
          m.style.opacity = "1";
          m.style.transform = "";
        });
      } else if (type === "meter") {
        const mask = feature.querySelector<SVGElement>("[data-meter-mask]");
        if (mask) (mask as unknown as HTMLElement).style.strokeDashoffset = "0";
        const big = feature.querySelector<HTMLElement>("[data-meter-big]");
        if (big) big.textContent = big.dataset.target || big.textContent || "";
        const headerNum = feature.querySelector<HTMLElement>("[data-meter-header-num]");
        if (headerNum) headerNum.textContent = headerNum.dataset.target || headerNum.textContent || "";
        const footNum = feature.querySelector<HTMLElement>("[data-meter-foot-num]");
        if (footNum) footNum.textContent = footNum.dataset.target || footNum.textContent || "";
      }
    };
    features.forEach(forceFinalChartState);

    // Reporting chart has an ambient twinkle loop in desktop — keep it on
    // mobile/tablet too. It's a passive setInterval, no scroll trigger needed.
    features.forEach((feature) => {
      if (feature.dataset.chart !== "reporting") return;
      const allCells = Array.from(
        feature.querySelectorAll<HTMLElement>(".reporting-matrix .cell")
      );
      if (!allCells.length) return;
      // Initial state: ~40% lit (steady state aims at ~50/50 like desktop)
      const initialLitCount = Math.floor(allCells.length * 0.4);
      [...allCells]
        .sort(() => Math.random() - 0.5)
        .slice(0, initialLitCount)
        .forEach((cell) => cell.classList.add("is-lit"));
      // Continuous twinkle: light 3-6 cells every 120ms with 0.8-2s lifespan
      setInterval(() => {
        const n = 3 + Math.floor(Math.random() * 4);
        for (let i = 0; i < n; i++) {
          const cell = allCells[Math.floor(Math.random() * allCells.length)];
          if (!cell.classList.contains("is-lit")) {
            cell.classList.add("is-lit");
            const lifespan = 800 + Math.random() * 1200;
            setTimeout(() => cell.classList.remove("is-lit"), lifespan);
          }
        }
      }, 120);
    });

    // Inject prev/next buttons after the stack.
    const nav = document.createElement("div");
    nav.className = "sfv-mobile-nav";
    nav.innerHTML = `
      <button type="button" class="sfv-arrow sfv-arrow--prev" aria-label="Recurso anterior">
        <svg viewBox="0 0 18 18" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M11.25 5.25L7.5 9l3.75 3.75V5.25z" />
        </svg>
      </button>
      <button type="button" class="sfv-arrow sfv-arrow--next" aria-label="Proximo recurso">
        <svg viewBox="0 0 18 18" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M7.5 5.25L11.25 9 7.5 12.75V5.25z" />
        </svg>
      </button>
    `;
    stack.parentElement?.appendChild(nav);

    const prev = nav.querySelector<HTMLButtonElement>(".sfv-arrow--prev");
    const next = nav.querySelector<HTMLButtonElement>(".sfv-arrow--next");

    const scrollToIdx = (i: number) => {
      const target = features[Math.max(0, Math.min(features.length - 1, i))];
      if (!target) return;
      stack.scrollTo({ left: target.offsetLeft, behavior: "smooth" });
    };
    const currentIdx = () => {
      const left = stack.scrollLeft;
      let best = 0;
      let bestDist = Infinity;
      features.forEach((f, i) => {
        const d = Math.abs(f.offsetLeft - left);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      return best;
    };

    const updateArrows = () => {
      const i = currentIdx();
      if (prev) prev.disabled = i <= 0;
      if (next) next.disabled = i >= features.length - 1;
    };

    prev?.addEventListener("click", () => scrollToIdx(currentIdx() - 1));
    next?.addEventListener("click", () => scrollToIdx(currentIdx() + 1));
    stack.addEventListener("scroll", updateArrows, { passive: true });
    updateArrows();
  }

  const init = () => {
    // Mobile + tablet share the slider experience; desktop (>=1024) gets the pinned scroll storyboard.
    const isMobile = window.matchMedia("(max-width: 1023px)").matches;
    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      isMobile
    ) {
      document.documentElement.classList.remove("sfv-pre-anim");
      if (isMobile) wireMobileSlider();
      return;
    }

    const section = document.querySelector<HTMLElement>("[data-sfv-section]");
    if (!section) return;

    const features = gsap.utils.toArray<HTMLElement>("[data-sfv-feature]", section);
    if (!features.length) return;

    // ---- Build SplitText per feature (title + desc → lines mask) ----
    type RecursoSplits = {
      title: SplitText | null;
      desc: SplitText | null;
    };
    const splits: RecursoSplits[] = features.map((f) => {
      const titleEl = f.querySelector<HTMLElement>("[data-feature-title]");
      const descEl = f.querySelector<HTMLElement>("[data-feature-desc]");
      return {
        title: titleEl ? new SplitText(titleEl, { type: "lines", mask: "lines" }) : null,
        desc: descEl ? new SplitText(descEl, { type: "lines", mask: "lines" }) : null,
      };
    });

    const setTextHidden = (idx: number) => {
      const s = splits[idx];
      if (s.title) gsap.set(s.title.lines, { yPercent: 110 });
      if (s.desc) gsap.set(s.desc.lines, { yPercent: 110 });
    };

    // Icon pixel cells per feature — for scramble/rebuild transitions
    const iconCellsPerRecurso = features.map((f) =>
      gsap.utils.toArray<HTMLElement>("[data-icon-cell-on='true']", f)
    );
    const setIconHidden = (idx: number) => {
      gsap.set(iconCellsPerRecurso[idx], { opacity: 0, scale: 0.4, transformOrigin: "center" });
    };
    const animateIconRebuild = (idx: number, delay = 0) => {
      const cells = iconCellsPerRecurso[idx];
      if (!cells.length) return;
      gsap.fromTo(
        cells,
        { opacity: 0, scale: 0.4, transformOrigin: "center" },
        {
          opacity: 1,
          scale: 1,
          duration: 0.5,
          ease: "eagleDecor",
          stagger: { each: 0.012, from: "random" },
          delay,
        }
      );
    };
    const animateIconScramble = (idx: number) => {
      const cells = iconCellsPerRecurso[idx];
      if (!cells.length) return;
      gsap.to(cells, {
        opacity: 0,
        scale: 0.4,
        duration: 0.35,
        ease: "eagleExit",
        stagger: { each: 0.008, from: "random" },
      });
    };
    const animateText = (idx: number, delay = 0) => {
      const s = splits[idx];
      if (s.title) {
        gsap.to(s.title.lines, {
          yPercent: 0,
          duration: 0.75,
          ease: "eagleReveal",
          stagger: 0.09,
          delay,
        });
      }
      if (s.desc) {
        gsap.to(s.desc.lines, {
          yPercent: 0,
          duration: 0.6,
          ease: "eagleReveal",
          stagger: 0.06,
          delay: delay + 0.18,
        });
      }
    };

    // ---- Pre-anim state for each feature ----
    features.forEach((f, idx) => {
      gsap.set(f, {
        opacity: idx === 0 ? 1 : 0,
        scale: idx === 0 ? 1 : 0.95,
        autoAlpha: idx === 0 ? 1 : 0,
      });
      setTextHidden(idx);
      setIconHidden(idx);
    });

    // Active twinkle timers per feature index — so we can stop them on deactivate
    const twinkleTimers = new Map<number, ReturnType<typeof setInterval>>();
    const stopTwinkle = (feature: HTMLElement) => {
      const idx = parseInt(feature.dataset.idx || "0", 10);
      const t = twinkleTimers.get(idx);
      if (t) {
        clearInterval(t);
        twinkleTimers.delete(idx);
      }
      // Clear lit state
      feature.querySelectorAll(".reporting-matrix .cell.is-lit").forEach((el) => el.classList.remove("is-lit"));
    };

    // Reset chart elements to initial state
    const resetChartState = (feature: HTMLElement) => {
      const chartType = feature.dataset.chart;
      if (chartType === "reporting") {
        // Stop any ongoing twinkle, clear all lit cells
        stopTwinkle(feature);
        const values = feature.querySelectorAll<HTMLElement>("[data-reporting-value]");
        values.forEach((v) => gsap.set(v, { opacity: 0 }));
      } else if (chartType === "livesystem") {
        // Anomaly bar chart — reset bars to height 0
        const bars = feature.querySelectorAll<HTMLElement>("[data-ano-bar]");
        gsap.set(bars, { height: 0 });
        const num = feature.querySelector<HTMLElement>("[data-anomaly-num]");
        if (num) num.textContent = "0";
        const axis = feature.querySelectorAll<HTMLElement>("[data-ls-axis]");
        gsap.set(axis, { opacity: 0, y: 4 });
      } else if (chartType === "lock") {
        // Lock pixel art + trust marquee
        const lockCells = feature.querySelectorAll<HTMLElement>(".lock-cell.on");
        gsap.set(lockCells, { opacity: 0, scale: 0.6, transformOrigin: "center" });
        const marquees = feature.querySelectorAll<HTMLElement>("[data-trust-marquee]");
        gsap.set(marquees, { opacity: 0, y: 12 });
      } else if (chartType === "meter") {
        // Mask circle revelars the active ring path: dashoffset 100 → 0
        const mask = feature.querySelector<SVGCircleElement>("[data-meter-mask]");
        if (mask) gsap.set(mask, { strokeDashoffset: 100 });
        const big = feature.querySelector<HTMLElement>("[data-meter-big]");
        if (big) big.textContent = "0";
        const headerNum = feature.querySelector<HTMLElement>("[data-meter-header-num]");
        if (headerNum) headerNum.textContent = "0";
        const footNum = feature.querySelector<HTMLElement>("[data-meter-foot-num]");
        if (footNum) footNum.textContent = "0";
      }
    };

    features.forEach(resetChartState);

    // ---- Per-feature chart animation builders ----
    const animateReporting = (feature: HTMLElement, tl: gsap.core.Timeline, pos: number) => {
      const blocks = feature.querySelectorAll<HTMLElement>("[data-reporting-block]");
      const idx = parseInt(feature.dataset.idx || "0", 10);

      blocks.forEach((block, blockIdx) => {
        const value = block.querySelector<HTMLElement>("[data-reporting-value]");
        const blockStart = pos + blockIdx * 0.08;
        if (value) {
          tl.to(value, { opacity: 1, duration: 0.25, ease: "eagleReveal" }, blockStart + 0.15);
        }
      });

      // Initial wave: light up ~70% of cells in a fast stagger
      const allCells = Array.from(
        feature.querySelectorAll<HTMLElement>(".reporting-matrix .cell")
      );
      const initialLitCount = Math.floor(allCells.length * 0.7);
      const shuffled = [...allCells].sort(() => Math.random() - 0.5).slice(0, initialLitCount);
      shuffled.forEach((cell, i) => {
        gsap.delayedCall(pos + 0.05 + i * 0.003, () => {
          cell.classList.add("is-lit");
          gsap.delayedCall(1.4 + Math.random() * 2.0, () => cell.classList.remove("is-lit"));
        });
      });

      // After the intro, ambient twinkle — dense & continuous
      const ambientStart = pos + 0.7;
      gsap.delayedCall(ambientStart, () => {
        if (twinkleTimers.has(idx)) return;
        const timer = setInterval(() => {
          // Light 7-12 random cells per tick
          const n = 7 + Math.floor(Math.random() * 6);
          for (let i = 0; i < n; i++) {
            const cell = allCells[Math.floor(Math.random() * allCells.length)];
            if (!cell.classList.contains("is-lit")) {
              cell.classList.add("is-lit");
              const lifespan = 1400 + Math.random() * 2200;
              setTimeout(() => cell.classList.remove("is-lit"), lifespan);
            }
          }
        }, 80);
        twinkleTimers.set(idx, timer);
      });
    };

    const animateAnomaly = (feature: HTMLElement, tl: gsap.core.Timeline, pos: number) => {
      // Number count-up
      const num = feature.querySelector<HTMLElement>("[data-anomaly-num]");
      if (num) {
        const target = parseInt(num.dataset.target || "124", 10);
        const proxy = { val: 0 };
        tl.to(proxy, {
          val: target,
          duration: 0.6,
          ease: "eagleReveal",
          snap: { val: 1 },
          onUpdate: () => {
            num.textContent = proxy.val.toLocaleString("en-US");
          },
        }, pos);
      }
      // Bars grow from bottom — height 0 → target%, staggered left → right
      const bars = feature.querySelectorAll<HTMLElement>("[data-ano-bar]");
      bars.forEach((bar, i) => {
        const targetH = parseFloat(bar.dataset.targetH || "0.3");
        tl.to(bar, {
          height: `${targetH * 100}%`,
          duration: 0.55,
          ease: "eagleStructure",
        }, pos + 0.15 + i * 0.08);
      });
      // Day axis fades in after bars
      const axis = feature.querySelectorAll<HTMLElement>("[data-ls-axis]");
      if (axis.length) {
        tl.to(axis, { opacity: 1, y: 0, duration: 0.3, ease: "eagleReveal", stagger: 0.03 }, pos + 0.85);
      }
    };

    const animateSecurity = (feature: HTMLElement, tl: gsap.core.Timeline, pos: number) => {
      const lockCells = feature.querySelectorAll<HTMLElement>(".lock-cell.on");
      const marquees = feature.querySelectorAll<HTMLElement>("[data-trust-marquee]");
      // Lock builds pixel-by-pixel from center outward
      if (lockCells.length) {
        tl.to(lockCells, {
          opacity: 1,
          scale: 1,
          duration: 0.04,
          ease: "eagleDecor",
          stagger: { each: 0.003, from: "center" },
        }, pos);
      }
      // Marquees fade up after lock builds
      if (marquees.length) {
        tl.to(marquees, {
          opacity: 1,
          y: 0,
          duration: 0.5,
          ease: "eagleReveal",
          stagger: 0.12,
        }, pos + 0.6);
      }
    };

    const animateMeter = (feature: HTMLElement, tl: gsap.core.Timeline, pos: number) => {
      const mask = feature.querySelector<SVGCircleElement>("[data-meter-mask]");
      const big = feature.querySelector<HTMLElement>("[data-meter-big]");
      const headerNum = feature.querySelector<HTMLElement>("[data-meter-header-num]");
      const footNum = feature.querySelector<HTMLElement>("[data-meter-foot-num]");

      // Mask revelar — circle stroke-dashoffset 100 → 0 wipes the active ring into view
      if (mask) {
        tl.to(mask, {
          strokeDashoffset: 0,
          duration: 0.95,
          ease: "eagleStructure",
        }, pos);
      }

      // Header yellow count-up
      if (headerNum) {
        const target = parseInt(headerNum.dataset.target || "48", 10);
        const proxy = { val: 0 };
        tl.to(proxy, {
          val: target,
          duration: 0.7,
          ease: "eagleStructure",
          snap: { val: 1 },
          onUpdate: () => {
            headerNum.textContent = String(proxy.val);
          },
        }, pos + 0.05);
      }

      // Center big % count-up — number only (the literal "%" lives in the markup)
      if (big) {
        const target = parseInt(big.dataset.target || "28", 10);
        const proxy = { val: 0 };
        tl.to(proxy, {
          val: target,
          duration: 0.85,
          ease: "eagleReveal",
          snap: { val: 1 },
          onUpdate: () => {
            big.textContent = String(proxy.val);
          },
        }, pos + 0.2);
      }

      // Bottom-right partial count-up
      if (footNum) {
        const target = parseInt(footNum.dataset.target || "84", 10);
        const proxy = { val: 0 };
        tl.to(proxy, {
          val: target,
          duration: 0.7,
          ease: "eagleReveal",
          snap: { val: 1 },
          onUpdate: () => {
            footNum.textContent = String(proxy.val);
          },
        }, pos + 0.35);
      }
    };

    const animateChart = (feature: HTMLElement, tl: gsap.core.Timeline, pos: number) => {
      const type = feature.dataset.chart;
      if (type === "reporting") animateReporting(feature, tl, pos);
      else if (type === "livesystem") animateAnomaly(feature, tl, pos);
      else if (type === "lock") animateSecurity(feature, tl, pos);
      else if (type === "meter") animateMeter(feature, tl, pos);
    };

    document.documentElement.classList.remove("sfv-pre-anim");

    // First feature: chart + text + icon rebuild run once on mount (intro)
    {
      const introTl = gsap.timeline();
      animateChart(features[0], introTl, 0);
      animateText(0, 0.1);
      animateIconRebuild(0, 0);
    }

    // ---- Active feature tracking — discrete state per scroll-snap point ----
    let currentIdx = 0;
    const totalSteps = features.length - 1; // 3 transitions for 4 features

    const activateRecurso = (newIdx: number) => {
      if (newIdx === currentIdx) return;
      const prevIdx = currentIdx;
      currentIdx = newIdx;

      // Outgoing — fade card + scramble icon out
      gsap.to(features[prevIdx], {
        autoAlpha: 0,
        scale: 0.95,
        duration: 0.45,
        ease: "eagleReveal",
      });
      animateIconScramble(prevIdx);

      // Incoming — fade card in
      gsap.fromTo(
        features[newIdx],
        { autoAlpha: 0, scale: 0.96 },
        {
          autoAlpha: 1,
          scale: 1,
          duration: 0.55,
          ease: "eagleReveal",
        }
      );

      // Reset and run chart anim of incoming
      resetChartState(features[newIdx]);
      const chartTl = gsap.timeline({ delay: 0.15 });
      animateChart(features[newIdx], chartTl, 0);

      // Text revelar (line stagger)
      setTextHidden(newIdx);
      animateText(newIdx, 0.2);

      // Icon rebuild — pixel-by-pixel from random into the new pattern
      animateIconRebuild(newIdx, 0.25);

    };

    // ---- ScrollTrigger pin + snap (no scrub — animations fire on activation) ----
    // Offset the comeca by the real navbar height so the pinned section sits
    // BELOW the sticky nav instead of being partially covered by it.
    const navEl = document.querySelector<HTMLElement>("header");
    const navOffset = navEl ? navEl.offsetHeight : 80;
    ScrollTrigger.create({
      trigger: section,
      comeca: `top top+=${navOffset}`,
      end: `+=${totalSteps * 100}%`,
      pin: "[data-sfv-pin]",
      pinSpacing: true,
      snap: {
        snapTo: (value) => {
          // Snap to closest of [0, 1/3, 2/3, 1] for 4 features
          const step = 1 / totalSteps;
          return Math.round(value / step) * step;
        },
        duration: { min: 0.25, max: 0.6 },
        ease: "eagleReveal",
        delay: 0.05,
      },
      onUpdate: (self) => {
        const idx = Math.round(self.progress * totalSteps);
        if (idx !== currentIdx) activateRecurso(idx);
      },
      invalidateOnRefresh: true,
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  // Mobile + tablet chart scaling
  // Tablet (768-1023): one shared scale via --sfv-chart-scale CSS var.
  // Mobile (<768): per-chart inline scale so each chart fits its OWN width
  //   to viewport-minus-padding, yet every chart's *visible* height matches
  //   the first chart (so the slider doesn't get tall on chart 2/3/4).
  const sfvCharts = (): HTMLElement[] =>
    Array.from(document.querySelectorAll<HTMLElement>(".feature-chart > .chart"));
  const sfvWrappers = (): HTMLElement[] =>
    Array.from(document.querySelectorAll<HTMLElement>(".feature-chart"));

  const measureSfvCharts = () => {
    sfvCharts().forEach((c) => {
      if (c.dataset.naturalW) return;
      const prev = c.style.transform;
      c.style.transform = "none";
      const r = c.getBoundingClientRect();
      c.style.transform = prev;
      c.dataset.naturalW = String(Math.round(r.width));
      c.dataset.naturalH = String(Math.round(r.height));
    });
  };

  const setSfvChartEscale = () => {
    measureSfvCharts();
    const vw = window.innerWidth;
    const charts = sfvCharts();
    const wrappers = sfvWrappers();
    const root = document.documentElement;

    if (vw >= 1024) {
      // Desktop: no scaling
      root.style.removeProperty("--sfv-chart-scale");
      charts.forEach((c) => c.style.removeProperty("transform"));
      wrappers.forEach((w) => w.style.removeProperty("height"));
      return;
    }

    const availW = Math.min(vw - 32, 30 * 16); // 1rem padding each side, max 30rem

    if (vw >= 768) {
      // Tablet: single uniform scale via CSS var (current behavior)
      const refPx = 16 * 26.8125;
      const wrapperH = 23 * 16;
      const scale = Math.min(availW / refPx, wrapperH / refPx, 1);
      root.style.setProperty("--sfv-chart-scale", scale.toFixed(3));
      charts.forEach((c) => c.style.removeProperty("transform"));
      wrappers.forEach((w) => w.style.removeProperty("height"));
      return;
    }

    // Mobile: per-chart scale. Each chart fits the available width and keeps
    // its own natural aspect ratio. Wrapper height is auto so taller charts
    // are taller — no forced uniform height.
    root.style.removeProperty("--sfv-chart-scale");
    if (!charts.length) return;

    charts.forEach((c, i) => {
      const w = parseFloat(c.dataset.naturalW || "429");
      const h = parseFloat(c.dataset.naturalH || "388");
      const scale = Math.min(availW / w, 1);
      c.style.transform = `scale(${scale})`;
      c.style.transformOrigin = "center center";
      const wrap = wrappers[i];
      if (wrap) {
        wrap.style.height = `${h * scale}px`;
      }
    });
  };
  window.addEventListener("resize", setSfvChartEscale);
  // Run once after layout is settled (so getBoundingClientRect is accurate)
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setSfvChartEscale);
  } else {
    setSfvChartEscale();
  }
</script>
