  /* Bottom row */
  .meter-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }
  .meter-bot-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .meter-bot-stat-end {
    align-items: flex-end;
    text-align: right;
  }
  .meter-bot-num {
    font-size: 1.1rem;
    line-height: 1;
    letter-spacing: 1.5px;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 400;
  }
  .meter-bot-lbl {
    font-size: 0.6346rem;
    line-height: 1.286;
    letter-spacing: 0.9px;
    color: #616161;
    text-transform: uppercase;
  }

  /* === Responsive (compact pinned layout) === */
  @media (max-width: 62rem) {
    .feature-row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .feature-chart {
      justify-self: center;
    }
    .chart {
      width: 100%;
      max-width: 26.8125rem;
    }
  }
  @media (max-width: 47.9375rem) {
    .sfv-pin {
      height: auto;
      padding: 0 0 4rem;
    }
    .feature-text {
      gap: 1.25rem;
      min-height: auto;
    }
    .feature-decor {
      width: 2rem;
    }
    .feature-title {
      font-size: 1.5rem;
      letter-spacing: 2.4px;
      line-height: 1.2;
    }
    /* Charts keep their desktop dimensions on mobile/tablet — the JS-driven
       transform: scale handles fitting them to viewport. Internal sizes are
       NOT shrunk here (would break aspect ratios within the chart). */
  }
  @media (max-width: 29.9375rem) {
    .feature-title {
      font-size: 1.25rem;
      letter-spacing: 1.6px;
    }
    .feature-desc {
      font-size: 0.8125rem;
    }
