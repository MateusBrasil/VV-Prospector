  .meter-top-stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .meter-top-num {
    font-size: 1.4186rem;
    line-height: 1;
    letter-spacing: 2.72px;
    color: var(--color-accent);
    text-transform: uppercase;
    font-weight: 400;
    text-shadow:
      0 0 0.375rem rgba(253, 255, 34, 0.85),
      0 0 0.75rem rgba(253, 255, 34, 0.45),
      0 0 1.5rem rgba(253, 255, 34, 0.18);
  }
  .meter-top-meta {
    font-size: 0.7093rem;
    line-height: 1.286;
    letter-spacing: 1.36px;
    color: #616161;
    text-transform: uppercase;
  }

  /* Mid: ring centered + overlay */
  .meter-mid {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 0;
    width: 100%;
  }
  .meter-svg {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    display: block;
  }
  .meter-ring-active {
    /* Mid point between tight & medium */
    filter:
      drop-shadow(0 0 2px rgba(95, 92, 255, 0.55))
      drop-shadow(0 0 6px rgba(95, 92, 255, 0.35))
      drop-shadow(0 0 13px rgba(95, 92, 255, 0.18))
      drop-shadow(0 0 22px rgba(95, 92, 255, 0.08));
