                          fill="white"
                          fill-opacity="0.12"
                        />
                      </g>
                    </svg>

                    {/* Center overlay (HTML — easy to position) */}
                    <div class="meter-center-overlay">
                      <span class="meter-center-big">
                        <span data-meter-big data-target="28">0</span>%
                      </span>
                      <span class="meter-center-lbl">Avg Score</span>
                    </div>
                  </div>

                  {/* Bottom row */}
                  <div class="meter-bottom">
                    <span class="meter-bot-stat">
                      <span class="meter-bot-num">85%</span>
                      <span class="meter-bot-lbl">Optimal</span>
                    </span>
                    <span class="meter-bot-stat meter-bot-stat-end">
                      <span class="meter-bot-num">
                        <span data-meter-foot-num data-target="84">0</span>%
                      </span>
                      <span class="meter-bot-lbl">Partial</span>
                    </span>
                  </div>
                </div>
              )}
            </div>

            <div class="feature-text">
              <img class="feature-decor" src={f.decor} alt="" />
              <div class="feature-body">
                <div class="feature-icon" data-feature-icon aria-hidden="true">
                  {f.iconGrid.map((on) => (
                    <span
                      class:list={["icon-cell", on && "on"]}
                      data-icon-cell-on={on ? "true" : "false"}
                    />
                  ))}
                </div>
                <div class="feature-content">
                  <h3 class="feature-title" data-feature-title>{f.title}</h3>
                  <p class="feature-desc" data-feature-desc>{f.desc}</p>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

  </div>
</section>

<style>
  :root {
    --periwinkle: #b5d2ff;
    --periwinkle-glow: rgba(95, 92, 255, 0.78);
    --chart-bg: #141414;
    --chart-border: #343434;
  }

  .sfv {
    background: var(--color-bg);
    font-family: var(--font-mono);
    color: var(--color-fg);
    position: relative;
  }
  /* Pin container — full viewport while pinned */
  .sfv-pin {
    height: calc(100vh - var(--nav-height));
    display: grid;
    place-items: center;
    overflow: hidden;
    position: relative;
  }
  /* Stack: 4 features stacked in same grid cell (grid-area: 1/1) */
  .sfv-stack {
    display: grid;
    width: 100%;
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .feature-row {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: 26.8125rem 1fr;
    gap: 5.25rem;
    align-items: center;
    will-change: opacity, transform;
  }
  /* Initial visibility: feature-0 visible, others hidden (reinforced by GSAP) */
  .feature-row:not([data-idx="0"]) {
    opacity: 0;
  }

  /* Pre-anim hide for FOUC protection */
  .sfv-pre-anim [data-sfv-feature] {
    visibility: hidden;
  }

  /* ============================================================
     Mobile (<768px): horizontal scroll-snap slider with arrows.
     Pin / 4-card stack / opacity swaps are desktop-only. Each
     feature card stacks text on top, visual below. Two arrow
     controls jump between cards.
     ============================================================ */
  /* Slider layout active on mobile + tablet (<1024). Desktop uses the pinned
     scroll experience. */
  @media (max-width: 1023px) {
    .sfv-pin {
      height: auto;
      display: block;
      overflow: visible;
      padding: 0;
    }
    .sfv-stack {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 0;
      padding: 0;
      max-width: none;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .sfv-stack::-webkit-scrollbar {
      display: none;
    }
    .feature-row {
      grid-area: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      flex: 0 0 100vw;
      width: 100vw;
      min-width: 0;
      min-height: auto;
      padding: 0 1rem;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      gap: 1.5rem;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
    }
    .feature-text {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      /* !important needed: the desktop `.feature-text { min-height: 19.6875rem }`
         rule lives after this media block and would otherwise win the cascade. */
      min-height: 0 !important;
    }
    .feature-body {
      align-items: center;
      padding-top: 0 !important;
    }
    /* Hide the vertical decor SVG — it makes the layout feel lopsided when
       the row content is centered for the slider. */
    .feature-decor {
      display: none;
    }
    /* Hide the pixel-art icon on mobile/tablet — text is enough. */
    .feature-icon,
    .feature-icon-svg {
      display: none !important;
    }
    /* Charts: keep their desktop proportions (no rule-by-rule shrinking).
       Apply a uniform transform: scale so every chart fits the same
       wrapper box and aspect ratios stay intact. */
    .feature-chart {
      width: 100%;
      max-width: 30rem;
      margin: 0 auto;
      height: 23rem;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .feature-chart > .chart {
      transform: scale(var(--sfv-chart-scale, 0.6));
      transform-origin: center center;
      flex-shrink: 0;
    }
    /* Charts keep desktop dimensions (overrides the `.chart { width: 100% }`
       rule from the (max-width: 62rem) media block above so internal proportions
       are preserved — the JS-driven scale handles fitting them to viewport). */
    .feature-chart > .chart {
      width: 26.8125rem !important;
      height: 26.8125rem !important;
    }
    .feature-chart > .chart-reporting {
      width: fit-content !important;
      height: auto !important;
    }

    /* Mobile/tablet nav styles defined globally below (the nav is JS-injected
       and won't match Astro's scoped attribute selectors). */
  }

  /* === Text block === */
  .feature-text {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    min-height: 19.6875rem;
  }
  .feature-decor {
    width: 3.5625rem;
    flex-shrink: 0;
    align-self: stretch;
    object-fit: contain;
  }
  .feature-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }
  .feature-icon-svg {
    width: 3.1875rem;
    height: 3.1875rem;
    flex-shrink: 0;
    display: block;
  }
  .feature-icon {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 1px;
    width: 3.1875rem; /* 51px */
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
  }
  .icon-cell {
    aspect-ratio: 1 / 1;
    background: transparent;
  }
  .icon-cell.on {
    background: var(--periwinkle);
    box-shadow:
      0 0 4px rgba(95, 92, 255, 0.95),
      0 0 10px rgba(95, 92, 255, 0.6),
      0 0 20px rgba(95, 92, 255, 0.35),
      0 0 38px rgba(95, 92, 255, 0.15);
  }
  .feature-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .feature-title {
    font-size: 2rem;
    line-height: 1.25;
    letter-spacing: 3.84px;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 400;
    margin: 0;
    max-width: 29.875rem;
  }
  .feature-desc {
    font-size: 0.875rem;
    line-height: 1.2857;
    color: var(--color-muted);
    text-transform: uppercase;
    margin: 0;
    max-width: 29.875rem;
  }

  /* === Chart base === */
  .chart {
    width: 26.8125rem;
    height: 26.8125rem;
    background: var(--chart-bg);
    border: 1px solid var(--chart-border);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* === Row 1 — Reporting Insights (3 monthly heatmaps 22×4, faithful to SVG) === */
  .chart-reporting {
    width: fit-content;
    height: auto; /* hug content — fit cells + padding naturally */
    justify-content: flex-comeca;
    gap: 1.5rem;
  }
  .reporting-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .reporting-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7093rem;
    line-height: 1.4;
    letter-spacing: 1.3619px;
    text-transform: uppercase;
  }
  .reporting-label {
    color: var(--color-muted);
  }
  .reporting-value {
    color: var(--color-accent);
    text-shadow:
      0 0 4px rgba(253, 255, 34, 0.9),
      0 0 10px rgba(253, 255, 34, 0.45),
      0 0 18px rgba(253, 255, 34, 0.18);
  }
  .reporting-matrix {
    display: grid;
    grid-template-columns: repeat(22, 0.851rem); /* 13.619px — SVG-faithful cell width */
    grid-auto-rows: 0.851rem;
    gap: 0.2838rem; /* 4.54px — SVG-faithful gap */
    width: fit-content;
  }
  .reporting-matrix .cell {
    aspect-ratio: 1 / 1;
  }
  .reporting-matrix .cell {
    aspect-ratio: 1 / 1;
    background: var(--chart-border); /* gray base — always visible */
    transition: background-color 0.45s ease, box-shadow 0.45s ease;
  }
  .reporting-matrix .cell.is-lit {
    background: var(--periwinkle);
    box-shadow:
      0 0 6px rgba(95, 92, 255, 0.95),
      0 0 14px rgba(95, 92, 255, 0.6),
      0 0 28px rgba(95, 92, 255, 0.35),
      0 0 50px rgba(95, 92, 255, 0.15);
  }

  /* Common chart eyebrow header (white, centered — matches SVG title) */
  .chart-eyebrow {
    font-size: 0.7093rem;
    line-height: 1.4;
    letter-spacing: 1.36px;
    color: #ffffff;
    text-transform: uppercase;
    text-align: center;
    flex-shrink: 0;
    align-self: stretch;
  }

  /* === Chart 2 — Anomaly line chart === */
  .chart-anomaly {
    justify-content: flex-comeca;
    gap: 0.75rem;
  }
  .anomaly-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ls-label {
    font-size: 0.9931rem;
    line-height: 1.286;
    letter-spacing: 1.9067px;
    color: var(--color-muted);
