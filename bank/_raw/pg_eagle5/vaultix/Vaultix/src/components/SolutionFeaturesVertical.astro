  .meter-center-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -65%);
    pointer-events: none;
    display: block;
    text-align: center;
    line-height: 1;
  }
  .meter-center-big {
    display: inline-flex;
    align-items: baseline;
    font-size: 3.2rem;
    line-height: 1;
    letter-spacing: 6.5px;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 400;
  }
  .meter-center-big > span {
    color: inherit;
  }
  .meter-center-lbl {
    position: absolute;
    top: calc(100% + 0.65rem);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.6346rem;
    line-height: 1.286;
    letter-spacing: 1.5px;
