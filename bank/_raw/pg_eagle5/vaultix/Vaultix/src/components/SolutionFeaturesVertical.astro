---
// Deterministic LCG-based pattern generator (stable between renders)
function pattern(cols: number, rows: number, density: number, seed: number) {
  const total = cols * rows;
  const target = Math.round(total * density);
  const arr = new Array<boolean>(total).fill(false);
  let s = seed;
  let filled = 0;
  for (let i = 0; i < total * 4 && filled < target; i++) {
    s = (s * 9301 + 49297) % 233280;
    const idx = s % total;
    if (!arr[idx]) {
      arr[idx] = true;
      filled++;
    }
  }
  return arr;
}

// Chart 1 — 3 reporting matrices (22 cols × 4 rows = 88 cells each)
const january = pattern(22, 4, 0.7, 17);
const february = pattern(22, 4, 0.84, 43);
const march = pattern(22, 4, 0.9, 91);

const reportingBlocks = [
  { label: "Jan 2026", value: "+47.2K", grid: january },
  { label: "Feb 2026", value: "+38.9K", grid: february },
  { label: "Mar 2026", value: "+52.4K", grid: march },
];

// Chart 2 — Live anomaly line chart
const anomalyTabs = ["7d", "30d", "1m", "6m"];
const anomalyDays = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"];

// Generate a smooth-ish line path with peaks (anomaly events)
// 7 sample points across 7 days, normalized 0-1 (low → spike → low)
const anomalyPoints = [0.18, 0.32, 0.22, 0.85, 0.42, 0.68, 0.31];
// Spikes that we mark with accent dots
const anomalySpikes = [3, 5]; // indexes where peaks happen

// Chart 3 — Lock pixel art 18×18 (parsed pixel-perfect from chart-3.svg, 204 cells) + 2 marquee rows
const lockRows = [
  "000000011110000000",
  "000000110011000000",
  "000001100001100000",
  "000011000000110000",
  "000110000000011000",
  "000110000000011000",
  "000110000000011000",
  "011111111111111110",
  "111111111111111111",
  "111111100001111111",
  "111111100001111111",
  "111111110011111111",
  "111111110011111111",
  "111111110011111111",
  "111111110011111111",
  "111111110011111111",
  "111111111111111111",
  "011111111111111110",
];
const lockGrid = lockRows.flatMap((r) => r.split("").map((c) => c === "1"));

const trustRow1 = [
  "SOC 2 Type II",
  "256-bit Encryption",
  "Zero Trust",
  "GDPR Compliant",
  "ISO 27001",
];
const trustRow2 = [
  "End-to-End Encrypted",
  "Audit-ready",
  "Data Residency",
  "mTLS Identity",
  "HIPAA Aligned",
];

// Recurso icons — 10×10 pixel grids (parsed pixel-perfect from /eagle/features-vertical/icon-{1-4}.svg)
const icon1 = [
  "0000001110",
  "0111111110",
  "0100001110",
  "1110000000",
  "1110100000",
  "1110000000",
  "0100001110",
  "0111111110",
  "0000001110",
  "0000000000",
];
const icon2 = [
  "0111111100",
  "1000000010",
  "1011111010",
  "0011111000",
  "1111111110",
  "0000000000",
  "1011111010",
  "1000000010",
  "0111111100",
  "0000000000",
];
const icon3 = [
  "0000100000",
  "0111011100",
  "1111011110",
  "1111011110",
  "1000100010",
  "0100100100",
  "0100100100",
  "0010101000",
  "0001110000",
  "0000000000",
];
const icon4 = [
  "0001110000",
  "0110001100",
  "1000000010",
  "1000000010",
  "1110001110",
  "1001110010",
  "1110001110",
  "0001110000",
  "0001110000",
  "0000000000",
];
const toGrid = (arr: string[]) =>
  arr.flatMap((r) => r.split("").map((c) => c === "1"));

const features = [
  {
    id: "realtime",
    decor: "/eagle/features-vertical/decor-row1.svg",
    title: "Real-Time Pipeline Monitoraring",
    desc: "Track every data flow with sub-millisecond latency. Get alerts before your users notice.",
    iconGrid: toGrid(icon1),
    chart: "reporting",
  },
  {
    id: "anomaly",
    decor: "/eagle/features-vertical/decor-row2.svg",
    title: "Deteccao de anomalias com IA",
    desc: "Eagle learns your data patterns and flags drift, outliers, and failures automatically.",
    iconGrid: toGrid(icon2),
    chart: "livesystem",
  },
  {
    id: "security",
    decor: "/eagle/features-vertical/decor-row3.svg",
    title: "Seguranca de nivel empresarial",
    desc: "SOC 2 Type II certified. End-to-end encryption at rest and in transit.",
    iconGrid: toGrid(icon3),
    chart: "lock",
  },
  {
    id: "vector",
    decor: "/eagle/features-vertical/decor-row4.svg",
    title: "Banco vetorial integrado",
    desc: "Native vector search for embeddings. No external dependencies required.",
    iconGrid: toGrid(icon4),
    chart: "meter",
  },
];
---

<script is:inline>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("sfv-pre-anim");
  }
</script>

<section class="sfv" data-sfv-section>
  <div class="sfv-pin" data-sfv-pin>
    <div class="sfv-stack" data-sfv-stack>
      {
        features.map((f, idx) => (
          <article
            class="feature-row"
            data-sfv-feature
            data-idx={idx}
            data-chart={f.chart}
          >
            <div class="feature-chart">
              {/* === Chart 1 — Reporting Insights (3 live activity grids 22×4) === */}
              {f.chart === "reporting" && (
                <div class="chart chart-reporting">
                  <span class="chart-eyebrow">Reporting Insights · Pipeline Throughput</span>
                  {reportingBlocks.map((b) => (
                    <div class="reporting-block" data-reporting-block>
                      <div class="reporting-header">
                        <span class="reporting-label">{b.label}</span>
                        <span class="reporting-value" data-reporting-value data-target={b.value}>
                          {b.value}
                        </span>
                      </div>
                      <div class="reporting-matrix" data-reporting-matrix>
                        {Array.from({ length: 88 }).map(() => (
                          <span class="cell" />
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              )}

              {/* === Chart 2 — Anomaly bar chart (7 days, spikes highlighted yellow) === */}
              {f.chart === "livesystem" && (
                <div class="chart chart-anomaly">
                  <div class="anomaly-header">
                    <span class="ls-label">Live Detection</span>
                    <div class="ls-tabs">
                      {anomalyTabs.map((t, i) => (
                        <span class:list={["ls-tab", i === 0 && "is-active"]} data-ls-tab>
                          {t}
                        </span>
                      ))}
                    </div>
                  </div>
                  <div class="anomaly-stat">
                    <span data-anomaly-num data-target="124">0</span>
                    <span class="anomaly-stat-lbl">Events / 7d</span>
                  </div>
                  <div class="anomaly-bars">
                    {anomalyPoints.map((p, i) => (
                      <div
                        class:list={["ano-bar", anomalySpikes.includes(i) && "is-spike"]}
                        data-ano-bar
                        data-target-h={p.toFixed(2)}
                      ></div>
                    ))}
                  </div>
                  <div class="anomaly-axis">
                    {anomalyDays.map((d) => (
                      <span data-ls-axis>{d}</span>
                    ))}
                  </div>
                </div>
              )}

              {/* === Chart 3 — Lock pixel-art (18×18) + trust marquee === */}
              {f.chart === "lock" && (
                <div class="chart chart-trust">
                  <div class="lock-wrap">
                    <div class="lock-grid" data-lock-grid>
                      {lockGrid.map((on) => (
                        <span
                          class:list={["lock-cell", on && "on"]}
                          data-lock-cell-on={on ? "true" : "false"}
                        />
                      ))}
                    </div>
                  </div>
                  <div class="trust-marquees">
                    <div class="trust-marquee" data-trust-marquee>
                      <div class="trust-track">
                        {[...trustRow1, ...trustRow1].map((b) => (
                          <span class="trust-badge">
                            <span class="trust-dot" />
                            {b}
                          </span>
                        ))}
                      </div>
                    </div>
                    <div class="trust-marquee" data-trust-marquee>
                      <div class="trust-track trust-track-reverse">
                        {[...trustRow2, ...trustRow2].map((b) => (
                          <span class="trust-badge">
                            <span class="trust-dot" />
                            {b}
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {/* === Chart 4 — Vector Index gauge (HTML layout + SVG ring centered) === */}
              {f.chart === "meter" && (
                <div class="chart chart-meter">
                  {/* Top row */}
                  <div class="meter-top">
                    <span class="meter-top-label">Processing Requests</span>
                    <span class="meter-top-stat">
                      <span class="meter-top-num" data-meter-header-num data-target="48">0</span>
                      <span class="meter-top-meta">Tasks</span>
                    </span>
                  </div>

                  {/* Center: ring SVG + overlay with big % */}
                  <div class="meter-mid">
                    <svg
                      class="meter-svg"
                      viewBox="0 0 402 320"
                      preserveAspectRatio="xMidYMid meet"
                      aria-hidden="true"
                    >
                      <defs>
                        <mask id="meter-ring-revelar-mask">
                          <rect width="402" height="320" fill="black" />
                          <circle
                            class="meter-mask-circle"
                            data-meter-mask
                            cx="200"
                            cy="159"
                            r="113"
                            stroke="white"
                            stroke-width="80"
                            pathLength="100"
                            stroke-dasharray="100"
                            stroke-dashoffset="100"
                            fill="none"
                            transform="rotate(-135 200 159)"
                          />
                        </mask>
                      </defs>

                      <g transform="translate(0, 0)">
                        {/* Ring base — always visible (dim) */}
                        <path
