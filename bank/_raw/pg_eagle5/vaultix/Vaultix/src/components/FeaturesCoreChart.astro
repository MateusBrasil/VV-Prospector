              fill="#010101"
            />

            <path
              d="M201.015 247.688L201.049 251.983C200.804 251.985 200.559 251.986 200.313 251.986C200.068 251.986 199.823 251.985 199.578 251.983L199.612 247.688V247.685C199.845 247.687 200.079 247.691 200.313 247.691C200.547 247.691 200.781 247.687 201.014 247.685L201.015 247.688ZM187.088 246.702C187.546 246.772 188.006 246.836 188.467 246.898V246.901L187.895 251.158C187.411 251.093 186.929 251.024 186.448 250.952L187.088 246.702ZM213.539 246.704L214.179 250.952C213.698 251.024 213.216 251.093 212.732 251.158L212.16 246.901L212.159 246.898C212.62 246.836 213.079 246.772 213.537 246.702L213.539 246.704ZM174.829 243.944C175.273 244.078 175.719 244.211 176.167 244.338L174.992 248.47C174.523 248.336 174.054 248.2 173.587 248.059L174.829 243.947V243.944ZM225.8 243.947L227.04 248.059C226.573 248.2 226.104 248.336 225.635 248.47L224.46 244.34L224.459 244.338C224.907 244.211 225.353 244.078 225.798 243.944L225.8 243.947ZM163.092 239.458C163.514 239.655 163.937 239.848 164.362 240.039V240.042L162.607 243.961C162.161 243.761 161.717 243.558 161.275 243.351L163.092 239.458ZM237.535 239.46L239.352 243.351C238.91 243.558 238.466 243.761 238.02 243.961L236.265 240.042L236.264 240.039C236.688 239.848 237.112 239.655 237.533 239.458L237.535 239.46ZM152.118 233.34C152.507 233.595 152.899 233.847 153.293 234.096L150.995 237.728C150.583 237.466 150.172 237.202 149.764 236.935L152.118 233.34ZM248.509 233.341L250.863 236.935C250.455 237.202 250.044 237.466 249.632 237.728L247.334 234.098L247.333 234.096C247.727 233.847 248.118 233.595 248.507 233.34L248.509 233.341ZM142.125 225.724C142.475 226.032 142.826 226.337 143.181 226.64L140.393 229.909C140.021 229.592 139.652 229.271 139.286 228.948L142.125 225.724ZM258.502 225.726L261.341 228.948C260.975 229.271 260.606 229.592 260.234 229.909L257.446 226.641L257.445 226.64C257.799 226.337 258.151 226.032 258.5 225.724L258.502 225.726Z"
              fill="white"
              fill-opacity="0.12"
            />
          </g>
        </svg>

        <div class="meter-center-overlay">
          <span class="meter-center-big">
            <span data-fcc-meter-big data-target="28">0</span>%
          </span>
          <span class="meter-center-lbl">Avg Score</span>
        </div>
      </div>

      <div class="meter-bottom">
        <span class="meter-bot-stat">
          <span class="meter-bot-num">85%</span>
          <span class="meter-bot-lbl">Optimal</span>
        </span>
        <span class="meter-bot-stat meter-bot-stat-end">
          <span class="meter-bot-num">
            <span data-fcc-meter-foot-num data-target="84">0</span>%
          </span>
          <span class="meter-bot-lbl">Partial</span>
        </span>
      </div>
    </div>
  )}
</div>

<style>
  :where(.fcc-wrap) {
    --periwinkle: #b5d2ff;
    --chart-bg: #141414;
    --chart-border: #343434;
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    color: var(--color-fg);
  }

  /* === Chart base === */
  .chart {
    width: 26.8125rem;
    height: 26.8125rem;
    background: var(--chart-bg);
    border: 1px solid var(--chart-border);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* === Reporting === */
  .chart-reporting {
    width: fit-content;
    height: auto;
    justify-content: flex-comeca;
    gap: 1.5rem;
  }
  .reporting-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .reporting-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7093rem;
    line-height: 1.4;
    letter-spacing: 1.3619px;
    text-transform: uppercase;
  }
  .reporting-label {
    color: var(--color-muted);
  }
  .reporting-value {
    color: var(--color-accent);
    text-shadow:
      0 0 4px rgba(253, 255, 34, 0.9),
      0 0 10px rgba(253, 255, 34, 0.45),
      0 0 18px rgba(253, 255, 34, 0.18);
  }
  .reporting-matrix {
    display: grid;
    grid-template-columns: repeat(22, 0.851rem);
    grid-auto-rows: 0.851rem;
    gap: 0.2838rem;
    width: fit-content;
  }
  .reporting-matrix .cell {
    aspect-ratio: 1 / 1;
    background: var(--chart-border);
    transition: background-color 0.45s ease, box-shadow 0.45s ease;
  }
  .reporting-matrix .cell.is-lit {
    background: var(--periwinkle);
    box-shadow:
      0 0 6px rgba(95, 92, 255, 0.95),
      0 0 14px rgba(95, 92, 255, 0.6),
      0 0 28px rgba(95, 92, 255, 0.35),
      0 0 50px rgba(95, 92, 255, 0.15);
  }

  .chart-eyebrow {
    font-size: 0.7093rem;
    line-height: 1.4;
    letter-spacing: 1.36px;
    color: #ffffff;
    text-transform: uppercase;
    text-align: center;
    flex-shrink: 0;
    align-self: stretch;
  }

  /* === Anomaly === */
  .chart-anomaly {
    justify-content: flex-comeca;
    gap: 0.75rem;
  }
  .anomaly-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ls-label {
    font-size: 0.9931rem;
    line-height: 1.286;
    letter-spacing: 1.9067px;
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .ls-tabs {
    display: flex;
  }
  .ls-tab {
    font-size: 0.6346rem;
    line-height: 1.286;
    letter-spacing: 0.6px;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    padding: 0.3626rem 0.7253rem;
    border: 1px solid var(--chart-border);
    background: var(--chart-bg);
    text-align: center;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .ls-tab.is-active {
    color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow:
      0 0 4px 0 rgba(253, 255, 34, 0.55),
      0 0 10px 0 rgba(253, 255, 34, 0.25);
  }
  .anomaly-stat {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-top: 0.25rem;
  }
  .anomaly-stat span:first-child {
    font-size: 2.6rem;
    line-height: 1;
    letter-spacing: 4.5px;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 400;
  }
  .anomaly-stat-lbl {
    font-size: 0.6346rem;
    line-height: 1.2;
    letter-spacing: 0.6px;
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .anomaly-bars {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex: 1;
    min-height: 11rem;
    width: 100%;
    gap: 0.65rem;
    padding: 0 0.25rem;
  }
  .ano-bar {
    flex: 1;
    background: var(--chart-border);
    transform-origin: bottom;
  }
  .ano-bar.is-spike {
    background: var(--periwinkle);
    box-shadow:
      0 0 6px rgba(95, 92, 255, 0.95),
      0 0 14px rgba(95, 92, 255, 0.6),
      0 0 28px rgba(95, 92, 255, 0.35),
      0 0 50px rgba(95, 92, 255, 0.15);
  }
  .anomaly-axis {
    display: flex;
    justify-content: space-between;
    font-size: 0.6346rem;
    line-height: 1.286;
    color: #616161;
    text-transform: uppercase;
    padding: 0 0.25rem;
  }

  /* === Trust === */
  .chart-trust {
    justify-content: space-between;
    padding: 0;
    overflow: hidden;
    position: relative;
  }
  .lock-wrap {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 0.5rem 0;
  }
  .lock-grid {
    width: 9.5rem;
    aspect-ratio: 1 / 1;
    display: grid;
    grid-template-columns: repeat(18, 1fr);
    grid-template-rows: repeat(18, 1fr);
    gap: 0.14rem;
  }
  .lock-cell {
    aspect-ratio: 1 / 1;
    background: transparent;
  }
  .lock-cell.on {
    background: var(--periwinkle);
    box-shadow:
      0 0 8px rgba(95, 92, 255, 1),
      0 0 18px rgba(95, 92, 255, 0.8),
      0 0 36px rgba(95, 92, 255, 0.5),
      0 0 64px rgba(95, 92, 255, 0.25),
      0 0 100px rgba(95, 92, 255, 0.1);
  }
  .trust-marquees {
    display: flex;
    flex-direction: column;
    gap: 0.5674rem;
    padding-bottom: 1.25rem;
  }
  .trust-marquee {
    overflow: hidden;
  }
  .trust-track {
    display: flex;
    gap: 0.5674rem;
    width: max-content;
    animation: fcc-trust-scroll 22s linear infinite;
  }
  .trust-track-reverse {
    animation-direction: reverse;
  }
  @keyframes fcc-trust-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5674rem;
    padding: 0.5674rem 1.1349rem;
    background: #050505;
    border: 1px solid var(--chart-border);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    line-height: 1.2;
    color: #ffffff;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .trust-dot {
    width: 0.32rem;
    height: 0.32rem;
    background: var(--color-accent);
    flex-shrink: 0;
    box-shadow:
      0 0 4px 0 rgba(253, 255, 34, 0.85),
      0 0 10px 0 rgba(253, 255, 34, 0.4);
    animation: fcc-trustDotPulse 1.8s ease-in-out infinite;
  }
  @keyframes fcc-trustDotPulse {
    0%, 100% {
      box-shadow:
        0 0 3px 0 rgba(253, 255, 34, 0.6),
        0 0 8px 0 rgba(253, 255, 34, 0.25);
    }
    50% {
      box-shadow:
        0 0 5px 0 rgba(253, 255, 34, 1),
        0 0 12px 0 rgba(253, 255, 34, 0.55),
        0 0 22px 0 rgba(253, 255, 34, 0.25);
    }
  }

  /* === Meter === */
  .chart-meter {
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    gap: 1rem;
  }
  .meter-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .meter-top-label {
    font-size: 0.7093rem;
    line-height: 1.286;
    letter-spacing: 1.36px;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
  }
  .meter-top-stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .meter-top-num {
    font-size: 1.4186rem;
    line-height: 1;
    letter-spacing: 2.72px;
    color: var(--color-accent);
    text-transform: uppercase;
    font-weight: 400;
    text-shadow:
      0 0 0.375rem rgba(253, 255, 34, 0.85),
      0 0 0.75rem rgba(253, 255, 34, 0.45),
      0 0 1.5rem rgba(253, 255, 34, 0.18);
  }
  .meter-top-meta {
    font-size: 0.7093rem;
    line-height: 1.286;
    letter-spacing: 1.36px;
    color: #616161;
    text-transform: uppercase;
  }
  .meter-mid {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 0;
    width: 100%;
  }
  .meter-svg {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    display: block;
  }
  .meter-ring-active {
    filter:
      drop-shadow(0 0 2px rgba(95, 92, 255, 0.55))
      drop-shadow(0 0 6px rgba(95, 92, 255, 0.35))
      drop-shadow(0 0 13px rgba(95, 92, 255, 0.18))
      drop-shadow(0 0 22px rgba(95, 92, 255, 0.08));
  }
  .meter-center-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -65%);
    pointer-events: none;
    display: block;
    text-align: center;
    line-height: 1;
  }
  .meter-center-big {
    display: inline-flex;
    align-items: baseline;
    font-size: 3.2rem;
    line-height: 1;
    letter-spacing: 6.5px;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 400;
  }
  .meter-center-big > span {
    color: inherit;
  }
  .meter-center-lbl {
    position: absolute;
    top: calc(100% + 0.65rem);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.6346rem;
    line-height: 1.286;
    letter-spacing: 1.5px;
    color: #616161;
    text-transform: uppercase;
  }
  .meter-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }
  .meter-bot-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .meter-bot-stat-end {
    align-items: flex-end;
    text-align: right;
  }
  .meter-bot-num {
    font-size: 1.1rem;
    line-height: 1;
    letter-spacing: 1.5px;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 400;
  }
  .meter-bot-lbl {
    font-size: 0.6346rem;
    line-height: 1.286;
    letter-spacing: 0.9px;
    color: #616161;
    text-transform: uppercase;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { registerEagleEases } from "../lib/eases";

  gsap.registerPlugin(ScrollTrigger);
  registerEagleEases();

  const prefersReducedMotion =
    typeof window !== "undefined" &&
    window.matchMedia &&
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ---- Jump to final state without animating (reduced motion / fallback) ----
  function jumpToFinal(chartEl: HTMLElement) {
    const type = chartEl.dataset.fccChart;
    if (type === "reporting") {
      const cells = chartEl.querySelectorAll<HTMLElement>("[data-fcc-reporting-cell]");
      // Light ~70% so the chart looks alive
      const litCount = Math.floor(cells.length * 0.7);
      const arr = Array.from(cells).sort(() => Math.random() - 0.5).slice(0, litCount);
      arr.forEach((c) => c.classList.add("is-lit"));
      chartEl
        .querySelectorAll<HTMLElement>("[data-fcc-reporting-value]")
        .forEach((v) => (v.style.opacity = "1"));
    } else if (type === "anomaly") {
      const num = chartEl.querySelector<HTMLElement>("[data-fcc-anomaly-num]");
      if (num) num.textContent = num.dataset.target || "124";
      chartEl.querySelectorAll<HTMLElement>("[data-fcc-ano-bar]").forEach((bar) => {
        const t = parseFloat(bar.dataset.targetH || "0.3");
        bar.style.height = `${(t * 100).toFixed(2)}%`;
      });
      chartEl.querySelectorAll<HTMLElement>("[data-fcc-ls-axis]").forEach((s) => {
        s.style.opacity = "1";
        s.style.transform = "translateY(0)";
      });
    } else if (type === "trust") {
      chartEl
        .querySelectorAll<HTMLElement>("[data-fcc-lock-cell-on]")
        .forEach((c) => {
          c.style.opacity = "1";
          c.style.transform = "scale(1)";
        });
      chartEl.querySelectorAll<HTMLElement>("[data-fcc-trust-marquee]").forEach((m) => {
        m.style.opacity = "1";
        m.style.transform = "translateY(0)";
      });
    } else if (type === "meter") {
      const mask = chartEl.querySelector<SVGCircleElement>("[data-fcc-meter-mask]");
      if (mask) mask.setAttribute("stroke-dashoffset", "0");
      const big = chartEl.querySelector<HTMLElement>("[data-fcc-meter-big]");
      if (big) big.textContent = big.dataset.target || "28";
      const head = chartEl.querySelector<HTMLElement>("[data-fcc-meter-header-num]");
      if (head) head.textContent = head.dataset.target || "48";
      const foot = chartEl.querySelector<HTMLElement>("[data-fcc-meter-foot-num]");
      if (foot) foot.textContent = foot.dataset.target || "84";
    }
  }

  // ---- Per-variant animations (ported from SolutionRecursosVertical) ----
  function animateReporting(chartEl: HTMLElement) {
    const tl = gsap.timeline();
    const blocks = chartEl.querySelectorAll<HTMLElement>("[data-fcc-reporting-block]");
    blocks.forEach((block, blockIdx) => {
      const value = block.querySelector<HTMLElement>("[data-fcc-reporting-value]");
      const blockStart = blockIdx * 0.08;
      if (value) {
        tl.to(value, { opacity: 1, duration: 0.25, ease: "eagleReveal" }, blockStart + 0.15);
      }
    });

    const allCells = Array.from(
      chartEl.querySelectorAll<HTMLElement>(".reporting-matrix .cell")
    );
    const initialLitCount = Math.floor(allCells.length * 0.7);
    const shuffled = [...allCells].sort(() => Math.random() - 0.5).slice(0, initialLitCount);
    shuffled.forEach((cell, i) => {
      gsap.delayedCall(0.05 + i * 0.003, () => {
        cell.classList.add("is-lit");
        gsap.delayedCall(1.4 + Math.random() * 2.0, () => cell.classList.remove("is-lit"));
      });
    });

    // Ambient twinkle
    gsap.delayedCall(0.7, () => {
      setInterval(() => {
        const n = 7 + Math.floor(Math.random() * 6);
        for (let i = 0; i < n; i++) {
          const cell = allCells[Math.floor(Math.random() * allCells.length)];
          if (cell && !cell.classList.contains("is-lit")) {
            cell.classList.add("is-lit");
            const lifespan = 1400 + Math.random() * 2200;
            setTimeout(() => cell.classList.remove("is-lit"), lifespan);
          }
        }
      }, 80);
    });
  }

  function animateAnomaly(chartEl: HTMLElement) {
    const tl = gsap.timeline();
    const num = chartEl.querySelector<HTMLElement>("[data-fcc-anomaly-num]");
    if (num) {
      const target = parseInt(num.dataset.target || "124", 10);
      const proxy = { val: 0 };
      tl.to(proxy, {
        val: target,
        duration: 0.6,
        ease: "eagleReveal",
        snap: { val: 1 },
        onUpdate: () => {
          num.textContent = proxy.val.toLocaleString("en-US");
        },
      }, 0);
    }
    const bars = chartEl.querySelectorAll<HTMLElement>("[data-fcc-ano-bar]");
    bars.forEach((bar, i) => {
      const targetH = parseFloat(bar.dataset.targetH || "0.3");
      tl.to(bar, {
        height: `${targetH * 100}%`,
        duration: 0.55,
        ease: "eagleStructure",
      }, 0.15 + i * 0.08);
    });
    const axis = chartEl.querySelectorAll<HTMLElement>("[data-fcc-ls-axis]");
    if (axis.length) {
      tl.to(axis, {
        opacity: 1,
        y: 0,
        duration: 0.3,
        ease: "eagleReveal",
        stagger: 0.03,
      }, 0.85);
    }
  }

  function animateSecurity(chartEl: HTMLElement) {
    const tl = gsap.timeline();
    const lockCells = chartEl.querySelectorAll<HTMLElement>("[data-fcc-lock-cell-on]");
    const marquees = chartEl.querySelectorAll<HTMLElement>("[data-fcc-trust-marquee]");
    if (lockCells.length) {
      tl.to(lockCells, {
        opacity: 1,
        scale: 1,
        duration: 0.04,
        ease: "eagleDecor",
        stagger: { each: 0.003, from: "center" },
      }, 0);
    }
    if (marquees.length) {
      tl.to(marquees, {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "eagleReveal",
        stagger: 0.12,
      }, 0.6);
    }
  }

  function animateMeter(chartEl: HTMLElement) {
    const tl = gsap.timeline();
    const mask = chartEl.querySelector<SVGCircleElement>("[data-fcc-meter-mask]");
    const big = chartEl.querySelector<HTMLElement>("[data-fcc-meter-big]");
    const headerNum = chartEl.querySelector<HTMLElement>("[data-fcc-meter-header-num]");
    const footNum = chartEl.querySelector<HTMLElement>("[data-fcc-meter-foot-num]");

    if (mask) {
      tl.to(mask, {
        strokeDashoffset: 0,
        duration: 0.95,
        ease: "eagleStructure",
      }, 0);
    }
    if (headerNum) {
      const target = parseInt(headerNum.dataset.target || "48", 10);
      const proxy = { val: 0 };
      tl.to(proxy, {
        val: target,
        duration: 0.7,
        ease: "eagleStructure",
        snap: { val: 1 },
        onUpdate: () => {
          headerNum.textContent = String(proxy.val);
        },
      }, 0.05);
    }
    if (big) {
      const target = parseInt(big.dataset.target || "28", 10);
      const proxy = { val: 0 };
      tl.to(proxy, {
        val: target,
        duration: 0.85,
        ease: "eagleReveal",
        snap: { val: 1 },
        onUpdate: () => {
          big.textContent = String(proxy.val);
        },
      }, 0.2);
    }
    if (footNum) {
      const target = parseInt(footNum.dataset.target || "84", 10);
      const proxy = { val: 0 };
      tl.to(proxy, {
        val: target,
        duration: 0.7,
        ease: "eagleReveal",
        snap: { val: 1 },
        onUpdate: () => {
          footNum.textContent = String(proxy.val);
        },
      }, 0.35);
    }
  }

  function animateChart(chartEl: HTMLElement) {
    const type = chartEl.dataset.fccChart;
    if (type === "reporting") animateReporting(chartEl);
    else if (type === "anomaly") animateAnomaly(chartEl);
    else if (type === "trust") animateSecurity(chartEl);
    else if (type === "meter") animateMeter(chartEl);
  }

  // ---- Wire up ScrollTriggers ----
  const charts = document.querySelectorAll<HTMLElement>("[data-fcc-chart]");
  charts.forEach((chartEl) => {
    if (prefersReducedMotion) {
      jumpToFinal(chartEl);
      return;
    }
    ScrollTrigger.create({
      trigger: chartEl,
      comeca: "top 75%",
      once: true,
      onEnter: () => animateChart(chartEl),
    });
  });
</script>
