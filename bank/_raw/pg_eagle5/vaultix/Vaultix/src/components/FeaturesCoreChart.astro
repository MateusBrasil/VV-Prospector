                fill="#B5D2FF"
              />
            </g>

            <path
              d="M267.316 216.771L270.583 219.559C270.266 219.931 269.946 220.3 269.623 220.667L266.4 217.827L266.399 217.826C266.707 217.476 267.012 217.124 267.314 216.77L267.316 216.771ZM274.772 206.66L276.587 207.808L278.402 208.957C278.141 209.37 277.877 209.781 277.609 210.189L274.016 207.834L274.015 207.833C274.27 207.443 274.522 207.052 274.771 206.658L274.772 206.66ZM280.716 195.59L284.635 197.345C284.435 197.791 284.232 198.235 284.026 198.677L280.134 196.86L280.133 196.858C280.33 196.437 280.523 196.014 280.713 195.589L280.716 195.59ZM285.014 183.785L289.144 184.96C289.011 185.43 288.874 185.898 288.733 186.365L286.677 185.743L284.621 185.123L284.618 185.122C284.753 184.677 284.885 184.232 285.013 183.784L285.014 183.785ZM287.576 171.486L289.704 171.771L291.833 172.057C291.768 172.541 291.699 173.023 291.626 173.505L287.378 172.864L287.377 172.863C287.446 172.404 287.511 171.945 287.573 171.484L287.576 171.486ZM288.366 159.639C288.366 159.405 288.362 159.171 288.36 158.937H288.363L292.658 158.903C292.66 159.148 292.661 159.393 292.661 159.639C292.661 159.884 292.66 160.129 292.658 160.374L288.363 160.341L288.36 160.339C288.362 160.106 288.366 159.872 288.366 159.639ZM291.833 147.22L289.702 147.505L289.704 147.507L287.576 147.792H287.573C287.511 147.331 287.446 146.872 287.377 146.413L291.626 145.773C291.699 146.254 291.768 146.737 291.833 147.22ZM289.144 134.318L285.014 135.492C284.887 135.044 284.753 134.598 284.618 134.153H284.621L288.733 132.912C288.874 133.379 289.011 133.848 289.144 134.318ZM284.635 121.933L280.716 123.687H280.713C280.523 123.262 280.33 122.839 280.133 122.418L284.026 120.6C284.232 121.042 284.436 121.487 284.635 121.933ZM278.402 110.321L276.586 111.469L276.587 111.47L274.772 112.618C274.523 112.224 274.27 111.833 274.015 111.443L277.609 109.089C277.877 109.497 278.141 109.908 278.402 110.321ZM270.583 99.7182L267.316 102.506C267.013 102.152 266.707 101.8 266.399 101.451L269.623 98.6108C269.946 98.9772 270.266 99.3467 270.583 99.7182Z