---
// RecursosCoreChart — static, reusable extraction of the 4 chart variants
// from SolutionRecursosVertical. Renders the chart at full size (26.8125rem
// square) absolutely centered inside a relative parent. No scroll
// animations: charts render in their final "lit" state.

interface Props {
  variant: "reporting" | "anomaly" | "trust" | "meter";
  class?: string;
}

const { variant, class: className } = Astro.props;

// ---- Deterministic LCG-based pattern generator (stable between renders) ----
function pattern(cols: number, rows: number, density: number, seed: number) {
  const total = cols * rows;
  const target = Math.round(total * density);
  const arr = new Array<boolean>(total).fill(false);
  let s = seed;
  let filled = 0;
  for (let i = 0; i < total * 4 && filled < target; i++) {
    s = (s * 9301 + 49297) % 233280;
    const idx = s % total;
    if (!arr[idx]) {
      arr[idx] = true;
      filled++;
    }
  }
  return arr;
}

// ---- Reporting (3 monthly heatmaps 22×4) ----
const january = pattern(22, 4, 0.7, 17);
const february = pattern(22, 4, 0.84, 43);
const march = pattern(22, 4, 0.9, 91);

const reportingBlocks = [
  { label: "Jan 2026", value: "+47.2K", grid: january },
  { label: "Feb 2026", value: "+38.9K", grid: february },
  { label: "Mar 2026", value: "+52.4K", grid: march },
];

// ---- Anomaly ----
const anomalyTabs = ["7d", "30d", "1m", "6m"];
const anomalyDays = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"];
const anomalyPoints = [0.18, 0.32, 0.22, 0.85, 0.42, 0.68, 0.31];
const anomalySpikes = [3, 5];

// ---- Trust / Lock pixel art (18×18) ----
const lockRows = [
  "000000011110000000",
  "000000110011000000",
  "000001100001100000",
  "000011000000110000",
  "000110000000011000",
  "000110000000011000",
  "000110000000011000",
  "011111111111111110",
  "111111111111111111",
  "111111100001111111",
  "111111100001111111",
  "111111110011111111",
  "111111110011111111",
  "111111110011111111",
  "111111110011111111",
  "111111110011111111",
  "111111111111111111",
  "011111111111111110",
];
const lockGrid = lockRows.flatMap((r) => r.split("").map((c) => c === "1"));

const trustRow1 = [
  "SOC 2 Type II",
  "256-bit Encryption",
  "Zero Trust",
  "GDPR Compliant",
  "ISO 27001",
];
const trustRow2 = [
  "End-to-End Encrypted",
  "Audit-ready",
  "Data Residency",
  "mTLS Identity",
  "HIPAA Aligned",
];
---

<div class:list={["fcc-wrap", className]}>
  {/* === Reporting === */}
  {variant === "reporting" && (
    <div class="chart chart-reporting" data-fcc-chart="reporting">
      <span class="chart-eyebrow">Reporting Insights · Pipeline Throughput</span>
      {reportingBlocks.map((b) => (
        <div class="reporting-block" data-fcc-reporting-block>
          <div class="reporting-header">
            <span class="reporting-label">{b.label}</span>
            <span
              class="reporting-value"
              data-fcc-reporting-value
              style="opacity: 0;"
            >
              {b.value}
            </span>
          </div>
          <div class="reporting-matrix">
            {b.grid.map(() => (
              <span class="cell" data-fcc-reporting-cell />
            ))}
          </div>
        </div>
      ))}
    </div>
  )}

  {/* === Anomaly === */}
  {variant === "anomaly" && (
    <div class="chart chart-anomaly" data-fcc-chart="anomaly">
      <div class="anomaly-header">
        <span class="ls-label">Live Detection</span>
        <div class="ls-tabs">
          {anomalyTabs.map((t, i) => (
            <span class:list={["ls-tab", i === 0 && "is-active"]}>{t}</span>
          ))}
        </div>
      </div>
      <div class="anomaly-stat">
        <span data-fcc-anomaly-num data-target="124">0</span>
        <span class="anomaly-stat-lbl">Events / 7d</span>
      </div>
      <div class="anomaly-bars">
        {anomalyPoints.map((p, i) => (
          <div
            class:list={["ano-bar", anomalySpikes.includes(i) && "is-spike"]}
            data-fcc-ano-bar
            data-target-h={p.toString()}
            style="height: 0%"
          />
        ))}
      </div>
      <div class="anomaly-axis">
        {anomalyDays.map((d) => (
          <span
            data-fcc-ls-axis
            style="opacity: 0; transform: translateY(4px);"
          >
            {d}
          </span>
        ))}
      </div>
    </div>
  )}

  {/* === Trust === */}
  {variant === "trust" && (
    <div class="chart chart-trust" data-fcc-chart="trust">
      <div class="lock-wrap">
        <div class="lock-grid">
          {lockGrid.map((on) => (
            on ? (
              <span
                class="lock-cell on"
                data-fcc-lock-cell-on
                style="opacity: 0; transform: scale(0.6); transform-origin: center;"
              />
            ) : (
              <span class="lock-cell" />
            )
          ))}
        </div>
      </div>
      <div class="trust-marquees">
        <div
          class="trust-marquee"
          data-fcc-trust-marquee
          style="opacity: 0; transform: translateY(12px);"
        >
          <div class="trust-track">
            {[...trustRow1, ...trustRow1].map((b) => (
              <span class="trust-badge">
                <span class="trust-dot" />
                {b}
              </span>
            ))}
          </div>
        </div>
        <div
          class="trust-marquee"
          data-fcc-trust-marquee
          style="opacity: 0; transform: translateY(12px);"
        >
          <div class="trust-track trust-track-reverse">
            {[...trustRow2, ...trustRow2].map((b) => (
              <span class="trust-badge">
                <span class="trust-dot" />
                {b}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  {/* === Meter === */}
  {variant === "meter" && (
    <div class="chart chart-meter" data-fcc-chart="meter">
      <div class="meter-top">
        <span class="meter-top-label">Processing Requests</span>
        <span class="meter-top-stat">
          <span class="meter-top-num" data-fcc-meter-header-num data-target="48">0</span>
          <span class="meter-top-meta">Tasks</span>
        </span>
      </div>

      <div class="meter-mid">
        <svg
          class="meter-svg"
          viewBox="0 0 402 320"
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
        >
          <defs>
            <mask id="fcc-meter-ring-revelar-mask">
              <rect width="402" height="320" fill="black" />
              <circle
                class="meter-mask-circle"
                data-fcc-meter-mask
                cx="200"
                cy="159"
                r="113"
                stroke="white"
                stroke-width="80"
                pathLength="100"
                stroke-dasharray="100"
                stroke-dashoffset="100"
                fill="none"
                transform="rotate(-135 200 159)"
              />
            </mask>
          </defs>

          <g transform="translate(0, 0)">
            <path
              d="M107.679 67.005C126.001 48.6838 149.343 36.2068 174.756 31.152C200.168 26.0971 226.509 28.6915 250.447 38.6069C274.385 48.5223 294.845 65.3134 309.24 86.8569C323.634 108.4 331.318 133.729 331.318 159.639C331.318 185.549 323.634 210.878 309.24 232.421C294.845 253.965 274.385 270.756 250.447 280.671C226.509 290.587 200.168 293.181 174.756 288.126C149.344 283.071 126.001 270.594 107.68 252.273L138.056 221.897C150.369 234.21 166.058 242.595 183.137 245.993C200.216 249.39 217.919 247.646 234.007 240.982C250.095 234.318 263.846 223.033 273.521 208.554C283.195 194.075 288.359 177.053 288.359 159.639C288.359 142.225 283.195 125.203 273.521 110.724C263.846 96.2447 250.095 84.9597 234.007 78.2957C217.919 71.6318 200.216 69.8882 183.137 73.2854C166.058 76.6827 150.369 85.0682 138.056 97.3816L107.679 67.005Z"
              fill="#1C1C1C"
            />

            <g mask="url(#fcc-meter-ring-revelar-mask)">
