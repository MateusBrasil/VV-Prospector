---
import { getCollection } from "astro:content";
import HalftoneImage from "./HalftoneImage.astro";
import AccentButton from "./AccentButton.astro";

interface Props {
  /** Post id to exclude from the list — used by `/blog/[slug]` so the
   *  Related section never shows the post the reader is currently on. */
  excludeId?: string;
  /** Eyebrow line. Defaults to the Inicio variant. */
  eyebrow?: string;
  /** Section headline. Defaults to the Inicio variant. */
  headline?: string;
  /** Sub-headline / description. */
  subhead?: string;
  /** CTA button label. */
  ctaLabel?: string;
  /** CTA button href. */
  ctaHref?: string;
  /** Hide the CTA button entirely. */
  hideCta?: boolean;
}

const {
  excludeId,
  eyebrow = "[ blog ]",
  headline = "Latest from our blog",
  subhead = "Engenharia insights, product updates, and deep dives into AI infrastructure.",
  ctaLabel = "View all posts",
  ctaHref = "/blog",
  hideCta = false,
} = Astro.props;

// Latest 3 posts from the blog collection (optionally excluding one).
const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => p.id !== excludeId)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const fmtData = (d: Data) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<script is:inline>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("blog-pre-anim");
  }
</script>

<section
  class="relative bg-[#050505] py-12 md:py-[4.5rem]"
  data-blog-section
>
  {/* Header */}
  <div class="mx-auto w-full max-w-[70.5rem] px-4">
    <div class="flex flex-col gap-4 font-mono font-normal uppercase md:gap-3">
      <p
        class="text-[0.875rem] leading-[1.2857] tracking-[1.68px] text-[#B5D2FF]"
        data-blog-eyebrow
      >
        {eyebrow}
      </p>
      <h2
        class="text-[2.5rem] leading-none tracking-[4.8px] text-white md:text-[3rem] md:tracking-[5.76px]"
        data-blog-headline
      >
        {headline}
      </h2>
      <div
        class="flex flex-col items-comeca gap-[1.5rem]"
      >
        <p
          class="max-w-[33.875rem] text-[0.875rem] leading-[1.2857] tracking-[1.68px] text-white/60"
          data-blog-subhead
        >
          {subhead}
        </p>
        {!hideCta && (
          <AccentButton
           
            class="w-full shrink-0 self-stretch whitespace-nowrap text-center md:w-fit md:self-comeca"
            data-blog-cta
          >
            {ctaLabel}
          </AccentButton>
        )}
      </div>
    </div>
  </div>

  {/* Cards row */}
  <div class="relative mt-[2rem] lg:mt-[4.5rem]">
    {/* Top + bottom full-width horizontal lines.
        Using `left: calc(50% - 50vw); width: 100vw` instead of
        `left-1/2 + -translate-x-1/2 + w-screen` so GSAP can drive scaleX
        without colliding with Tailwind's translate transform. */}
    <span
      class="blog-edge-line pointer-events-none absolute top-0 h-px bg-[#343434]"
      data-blog-line="top"
      aria-hidden="true"
    ></span>
    <span
      class="blog-edge-line pointer-events-none absolute bottom-0 h-px bg-[#343434]"
      data-blog-line="bottom"
      aria-hidden="true"
    ></span>

    {/* Container — cards stay within max-width. Side borders are drawn by
        the animatable [data-blog-line="left|right"] spans below; no static
        CSS border-x so the entry animation isn't masked. */}
    <div
      class="relative mx-auto w-full max-w-[70.5rem] px-4 lg:px-0"
    >
      {/* Vertical border lines (animatable, sit on top of the static border) */}
      <span
        class="pointer-events-none absolute left-[calc(1rem-1px)] top-0 h-full w-px bg-[#343434] lg:left-[-1px]"
        data-blog-line="left"
        aria-hidden="true"
      ></span>
      <span
        class="pointer-events-none absolute right-[calc(1rem-1px)] top-0 h-full w-px bg-[#343434] lg:right-[-1px]"
        data-blog-line="right"
        aria-hidden="true"
      ></span>

      {/* 4 T corner markers */}
      <svg
        class="pointer-events-none absolute left-[calc(-0.5rem_-_1px)] top-[calc(-0.5rem_+_0.5px)] z-10 hidden h-4 w-4 text-white lg:block"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
        data-blog-tmark
      >
        <path d="M0 7.5H16V8.5H9V16H8V8.5H0Z"></path>
      </svg>
      <svg
        class="pointer-events-none absolute -right-2 top-[calc(-0.5rem_+_0.5px)] z-10 hidden h-4 w-4 text-white lg:block"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
        data-blog-tmark
      >
        <path d="M0 7.5H16V8.5H9V16H8V8.5H0Z"></path>
      </svg>
      <svg
        class="pointer-events-none absolute bottom-[calc(-0.5rem_+_0.5px)] left-[calc(-0.5rem_-_1px)] z-10 hidden h-4 w-4 text-white lg:block"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
        data-blog-tmark
      >
        <path d="M16 8.5H0V7.5H7V0H8V7.5H16Z"></path>
      </svg>
      <svg
        class="pointer-events-none absolute -right-2 bottom-[calc(-0.5rem_+_0.5px)] z-10 hidden h-4 w-4 text-white lg:block"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
        data-blog-tmark
      >
        <path d="M16 8.5H0V7.5H7V0H8V7.5H16Z"></path>
      </svg>

      <div
        class="grid grid-cols-1 divide-y divide-[#343434] border border-[#343434] md:grid-cols-3 md:divide-x md:divide-y-0 lg:border-0"
      >
        {
          posts.map((post, idx) => {
            const href = `/blog/${post.id}`;
            // 3 sibling halftone sources — same neighborhood, different
            // gradient direction per card.
            const halftoneSrc = `/blog/halftone-source-0${idx + 1}-bw.webp`;
            return (
              <article class="blog-card relative" data-blog-card>
                <a href={href} class="relative flex flex-col gap-6 p-[1.25rem] outline-none lg:p-8">
                  <div class="blog-card__thumb relative aspect-square w-full overflow-hidden md:aspect-[312/180]">
                    <HalftoneImage src={halftoneSrc} alt={post.data.title} />
                  </div>
                  <div class="flex flex-col gap-3 font-mono font-normal uppercase">
                    <div class="flex flex-col gap-1 text-white/60 lg:flex-row lg:items-center lg:gap-3">
                      <span class="text-[0.875rem] leading-[1.2857] tracking-[1.68px]">{post.data.category}</span>
                      <span aria-hidden="true" class="hidden lg:inline">•</span>
                      <span class="hidden text-[0.75rem] leading-[1.2857] tracking-[1.44px] md:inline lg:text-[0.875rem] lg:tracking-[1.68px]">{fmtData(post.data.date)}</span>
                    </div>
                    <h3 class="text-[1.25rem] leading-[1.2] tracking-normal text-white">
                      {post.data.title}
                    </h3>
                    <span class="blog-card__readmore inline-flex items-center self-comeca text-[0.875rem] leading-[1.2857] tracking-[1.68px] text-[var(--color-accent)]">
                      <span class="blog-card__readmore-text" data-blog-readmore>Ler mais</span>
                      <span class="blog-card__readmore-arrow" aria-hidden="true">→</span>
                    </span>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Pre-anim FOUC protection */
  .blog-pre-anim [data-blog-eyebrow],
  .blog-pre-anim [data-blog-headline],
  .blog-pre-anim [data-blog-subhead] {
    visibility: hidden;
  }
  .blog-pre-anim [data-blog-cta],
  .blog-pre-anim [data-blog-card] {
    visibility: hidden;
  }
  .blog-pre-anim [data-blog-line],
  .blog-pre-anim [data-blog-tmark] {
    opacity: 0;
  }

  /* Top/bottom horizontals.
     Mobile/tablet: respect the section's lateral padding (1rem each side).
     Desktop: full-width, drawn out from center via GSAP scaleX. */
  .blog-edge-line {
    left: 1rem;
    right: 1rem;
  }
  @media (min-width: 1024px) {
    .blog-edge-line {
      left: calc(50% - 50vw);
      right: auto;
      width: 100vw;
    }
  }

  /* Card hover — the halftone shimmer + glow carries the affordance.
     No yellow frame, no border accent. */
  .blog-card {
    background-color: transparent;
    transition: background-color 0.25s ease;
  }
  .blog-card:hover {
    background-color: rgba(255, 255, 255, 0.012);
  }

  /* Image stays static on hover — the halftone shimmer/glow carries it.
     Slot kept here in case we re-enable for non-HalftoneImage cards. */
  .blog-card__thumb {
    /* no transform on hover */
  }

  /* Ler mais — accent glow on hover.
     Uses filter: drop-shadow rather than text-shadow because the
     block-roll-up wrapper inside (.hover-stagger__inner) has
     overflow:hidden + clip-path:inset(0) — that clips text-shadow.
     drop-shadow on the parent paints around the rasterized output of
     all children (text + arrow), so the glow shows even with the inner clip. */
  .blog-card__readmore {
    transition: filter 0.35s ease;
  }
  .blog-card:hover .blog-card__readmore {
    filter:
      drop-shadow(0 0 4px rgba(253, 255, 34, 0.85))
      drop-shadow(0 0 10px rgba(253, 255, 34, 0.5))
      drop-shadow(0 0 18px rgba(253, 255, 34, 0.2));
  }

  /* Ler mais arrow revelar */
  .blog-card__readmore-arrow {
    display: inline-block;
    margin-left: 0;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    transition:
      max-width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      margin-left 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }
  .blog-card:hover .blog-card__readmore-arrow {
    max-width: 1.5em;
    margin-left: 0.5em;
    opacity: 1;
  }

  /* Focus visible for keyboard users */
  .blog-card a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card,
    .blog-card__thumb,
    .blog-card__readmore-arrow {
      transition: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { registerEagleEases } from "../lib/eases";
  import { applyScrambleHover } from "../lib/scramble-hover";

  gsap.registerPlugin(ScrollTrigger, SplitText);
  registerEagleEases();

  const init = () => {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (reduceMotion) {
      document.documentElement.classList.remove("blog-pre-anim");
      return;
    }

    const section = document.querySelector<HTMLElement>("[data-blog-section]");
    if (!section) return;

    const eyebrow = section.querySelector<HTMLElement>("[data-blog-eyebrow]");
    const headline = section.querySelector<HTMLElement>("[data-blog-headline]");
    const subhead = section.querySelector<HTMLElement>("[data-blog-subhead]");
    const cta = section.querySelector<HTMLElement>("[data-blog-cta]");
    const lines = gsap.utils.toArray<HTMLElement>("[data-blog-line]", section);
    const tmarks = gsap.utils.toArray<SVGElement>("[data-blog-tmark]", section);
    const cards = gsap.utils.toArray<HTMLElement>("[data-blog-card]", section);

    const eyebrowSplit = eyebrow
      ? new SplitText(eyebrow, { type: "lines", mask: "lines" })
      : null;
    const headlineSplit = headline
      ? new SplitText(headline, { type: "lines", mask: "lines" })
      : null;
    const subheadSplit = subhead
      ? new SplitText(subhead, { type: "lines", mask: "lines" })
      : null;

    // ---- Pre-anim states ----
    if (eyebrowSplit) gsap.set(eyebrowSplit.lines, { yPercent: 110 });
    if (headlineSplit) gsap.set(headlineSplit.lines, { yPercent: 110 });
    if (subheadSplit) gsap.set(subheadSplit.lines, { yPercent: 110 });
    if (cta) gsap.set(cta, { y: 12, scale: 0.96, opacity: 0, transformOrigin: "center" });

    lines.forEach((l) => {
      const orient = l.dataset.blogLine;
      if (orient === "top") {
        gsap.set(l, { scaleX: 0, transformOrigin: "left center", opacity: 1 });
      } else if (orient === "bottom") {
        gsap.set(l, { scaleX: 0, transformOrigin: "right center", opacity: 1 });
      } else if (orient === "left" || orient === "right") {
        // Both verticals draw top → bottom in sync.
        gsap.set(l, { scaleY: 0, transformOrigin: "center top", opacity: 1 });
      }
    });
    gsap.set(tmarks, { opacity: 0, scale: 0.4, transformOrigin: "center" });
    gsap.set(cards, { opacity: 0, y: 24 });

    document.documentElement.classList.remove("blog-pre-anim");

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        comeca: "top 80%",
        once: true,
      },
    });

    // 1. Horizontal lines — slow obvious draw
    const horizontals = lines.filter(
      (l) => l.dataset.blogLine === "top" || l.dataset.blogLine === "bottom"
    );
    const verticals = lines.filter(
      (l) => l.dataset.blogLine === "left" || l.dataset.blogLine === "right"
    );

    tl.to(
      horizontals,
      {
        scaleX: 1,
        duration: 1.4,
        ease: "eagleStructure",
        stagger: 0.1,
      },
      0.05
    );

    tl.to(
      verticals,
      {
        scaleY: 1,
        duration: 1.0,
        ease: "eagleStructure",
        stagger: 0.08,
      },
      0.3
    );

    // 2. T-markers
    tl.to(
      tmarks,
      {
        opacity: 1,
        scale: 1,
        duration: 0.45,
        ease: "eagleDecor",
        stagger: 0.06,
      },
      0.95
    );

    // 3. Heading block
    if (eyebrowSplit) {
      tl.to(
        eyebrowSplit.lines,
        {
          yPercent: 0,
          duration: 0.6,
          ease: "eagleReveal",
          stagger: 0.05,
        },
        0.35
      );
    }
    if (headlineSplit) {
      tl.to(
        headlineSplit.lines,
        {
          yPercent: 0,
          duration: 0.95,
          ease: "eagleReveal",
          stagger: 0.1,
        },
        0.5
      );
    }
    if (subheadSplit) {
      tl.to(
        subheadSplit.lines,
        {
          yPercent: 0,
          duration: 0.6,
          ease: "eagleReveal",
          stagger: 0.05,
        },
        0.7
      );
    }

    // 4. CTA "View all posts" entry
    if (cta) {
      tl.to(
        cta,
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.6,
          ease: "eagleReveal",
        },
        0.8
      );
    }

    // 5. Cards stagger
    if (cards.length) {
      tl.to(
        cards,
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: "eagleReveal",
          stagger: 0.1,
        },
        0.9
      );
    }

    // Apply block roll-up hover effect on the CTA + each card's "Ler mais".
    // The helper finds the closest <a>/<button> ancestor as the hover trigger,
    // so the whole card lifts the read-more text when hovered.
    try {
      applyScrambleHover("[data-blog-cta]", section);
      applyScrambleHover("[data-blog-readmore]", section);
    } catch (e) {
      if (import.meta.env.DEV) console.warn("[BlogsSection] scramble hover failed", e);
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
