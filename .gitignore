# Dependências e resultados reprodutíveis
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
themes/*/.obras/

# Artefatos locais de montagem, ensaio e QA
build/
sites/
ensaio/
baseline/
test-results/
playwright-report/
screenshots/
*.log
npm-debug.log*

# Estado operacional e configuração real (podem conter PII, contactos ou credenciais)
prospector.db
prospector.db-*
prospector-config.json
.env
.env.*
!.env.example
briefs/*
!briefs/_smoke-test-restaurante.json
planos/
clientes/*/
!clientes/_smoke-test-restaurante/
!clientes/_smoke-test-restaurante/**

# Ferramentas locais de deploy/cache e backups transitórios
.vercel/
.cache/
_bkp_teste/

# Metadados de workspaces importados: não são componentes nem código do produto e alguns
# apontam para repositórios Git incompletos, que o repositório principal não pode indexar.
**/.workspace/
**/code/.git/
